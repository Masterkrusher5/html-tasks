# --- HELPER: AUTONOMOUS COLUMN MAPPING ---
def autonomous_map_columns(actual_cols):
    """Uses Fuzzy Logic to automatically find columns in any CSV/Excel file."""
    mapping = {}
    standard_targets = {
        'subject': ['subject', 'title', 'topic', 'head', 're:', 'subj'],
        'body': ['body', 'content', 'message', 'text', 'mail', 'description'],
        'sender': ['sender', 'from', 'employee', 'author', 'originator'],
        'receiver': ['receiver', 'to', 'recipient', 'client', 'destination'],
        'thread_id': ['thread', 'conversation', 'group_id', 'link_id', 'thread_id']
    }
    
    for target, variations in standard_targets.items():
        best_match = None
        highest_score = 0
        for col in actual_cols:
            # Check similarity between the CSV column and our variations
            score = max([difflib.SequenceMatcher(None, str(col).lower(), v).ratio() for v in variations])
            if score > highest_score:
                highest_score = score
                best_match = col
        
        # If match is weak (< 0.5), we'll default to None or a placeholder
        mapping[target] = best_match if highest_score > 0.5 else None
    
    return mapping

# --- SIDEBAR CONTROLS ---
st.sidebar.title("🛡️ Surveillance Controls")
risk_trigger = st.sidebar.slider("AI Sensitivity (ML Risk Gate)", 0.0, 1.0, 0.4)
workers = st.sidebar.slider("Parallel Threads (Speed)", 5, 50, 20)

st.sidebar.divider()
