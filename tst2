import streamlit as st
import pandas as pd
import json
import time
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor
from ComplianceEngine import ComplianceEngine

# --- PAGE CONFIGURATION ---
st.set_page_config(
    page_title="AI Bank Compliance Surveillance",
    page_icon="🛡️",
    layout="wide"
)

# Initialize the High-Performance Engine
# Using cache_resource ensures the requests.Session is reused across interactions
@st.cache_resource
def get_engine():
    return ComplianceEngine()

engine = get_engine()

# --- SESSION STATE INITIALIZATION ---
if 'alerts' not in st.session_state:
    st.session_state.alerts = []
if 'thread_history' not in st.session_state:
    st.session_state.thread_history = {}

# --- SIDEBAR: SYSTEM CONTROLS ---
st.sidebar.title("⚙️ System Controls")

risk_threshold = st.sidebar.slider(
    "LLM Trigger Sensitivity", 
    0.0, 1.0, 0.4, 
    help="Determines which emails go to the AI. Lower = More sensitive/More AI costs. Higher = Faster/Filter more."
)

parallel_workers = st.sidebar.slider(
    "Parallel AI Workers", 
    5, 50, 20, 
    help="Simultaneous requests to the LLM. Recommended 20 for large batches."
)

st.sidebar.divider()
st.sidebar.subheader("Violation Weightage")
st.sidebar.write("System prioritization logic:")
matrix_display = pd.DataFrame(list(engine.matrix.items()), columns=['Category', 'Weight'])
st.sidebar.table(matrix_display)

# --- MAIN UI ---
st.title("🛡️ Enterprise Communication Surveillance")
st.markdown("Automated intent detection using Multi-Stage AI filtering and LLM Reasoning.")

tab1, tab2, tab3 = st.tabs(["🕒 Real-time Monitor", "🚀 High-Speed Batch Ingestion", "📊 Alert Dashboard"])

# --- TAB 1: REAL-TIME MONITOR ---
with tab1:
    st.subheader("Manual Communication Scan")
    with st.form("manual_entry_form"):
        col1, col2 = st.columns(2)
        sender = col1.text_input("Sender Email", "employee@bank.com")
        receiver = col2.text_input("External Party", "client@hedgefund.com")
        subject = st.text_input("Subject Line")
        thread_id = st.text_input("Thread ID (Conversation Group)", "TR-1001")
        body = st.text_area("Email Content", height=150)
        
        analyze_btn = st.form_submit_button("🚀 Run AI Analysis")

    if analyze_btn:
        if not body.strip() or not subject.strip():
            st.warning("Please provide both Subject and Body for analysis.")
        else:
            with st.status("Analyzing...", expanded=True) as status:
                # 1. Thread Context
                context = " | ".join(st.session_state.thread_history.get(thread_id, [])[-3:])
                
                # 2. Local Filters (Phase 1 & 2)
                if engine.pre_filter(subject, body):
                    st.info("System Filter: Identified as non-substantive/automated noise.")
                    status.update(label="Analysis Stopped: Noise Detected", state="complete")
                else:
                    ml_risk = engine.ml_risk_scoring(subject, body)
                    st.write(f"📈 Local Risk Score: **{ml_risk:.2f}**")
                    
                    if ml_risk >= risk_threshold:
                        # 3. AI Deep Scan (Phase 3)
                        st.write("🤖 Triggering Deep AI Intent Analysis...")
                        # Pass tuple: (index, context, subject, body)
                        res = engine.analyze_single_llm_call((0, context, subject, body))
                        
                        if res and not res.get("error"):
                            # Logic for Violation
                            st.error(f"🚨 Potential Violation Detected: {res['category']}")
                            st.write(f"**Reasoning:** {res['reason']}")
                            st.write(f"**Evidence:** `{res['evidence_line']}`")
                            
                            # Log to Alert Dashboard
                            res['timestamp'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                            res['subject'] = subject
                            res['sender'] = sender
                            res['receiver'] = receiver
                            st.session_state.alerts.insert(0, res)
                            
                            # Save to thread context
                            if thread_id not in st.session_state.thread_history:
                                st.session_state.thread_history[thread_id] = []
                            st.session_state.thread_history[thread_id].append(body)
                        else:
                            st.success("Analysis Complete: No malicious intent identified.")
                    else:
                        st.success("Risk level below threshold. Communication approved.")
                status.update(label="Surveillance Check Finished", state="complete")

# --- TAB 2: HIGH-SPEED BATCH INGESTION (5000+ Records) ---
with tab2:
    st.subheader("Bulk Data Pipeline")
    st.info("Use this tab to process large Excel or CSV files. The system uses parallel threading for speed.")
    
    uploaded_file = st.file_uploader("Upload CSV or Excel file", type=['csv', 'xlsx'])
    
    if uploaded_file:
        df = pd.read_csv(uploaded_file) if uploaded_file.name.endswith('.csv') else pd.read_excel(uploaded_file)
        st.write(f"📂 File Loaded: **{len(df)}** records found.")
        
        st.divider()
        st.write("### ⚙️ Column Mapping")
        cols = df.columns.tolist()
        c1, c2, c3, c4 = st.columns(4)
        
        # Select box with basic auto-detection
        s_col = c1.selectbox("Subject Column", cols, index=0 if 'subject' in str(cols).lower() else 0)
        b_col = c2.selectbox("Body/Message Column", cols, index=0 if 'body' in str(cols).lower() else 0)
        sender_col = c3.selectbox("Sender Column", cols)
        rec_col = c4.selectbox("Receiver Column", cols)

        if st.button("🚀 Start Bulk Surveillance Pipeline"):
            start_time = time.time()
            
            # --- PHASE 1: LOCAL WATERFALL FILTERING (Vectorized) ---
            st.write("🔍 Phase 1: Running Local Heuristic Filters...")
            
            # Corrected lambda syntax: axis=1 is outside the pre_filter call
            df['is_noise'] = df.apply(lambda r: engine.pre_filter(r[s_col], r[b_col]), axis=1)
            df['ml_score'] = df.apply(lambda r: engine.ml_risk_scoring(r[s_col], r[b_col]), axis=1)
            
            # Extract items that are NOT noise and ARE risky
            to_analyze = df[(df['is_noise'] == False) & (df['ml_score'] >= risk_threshold)].copy()
            
            st.write(f"✅ Filtered out **{len(df) - len(to_analyze)}** noise/safe emails.")
            st.write(f"🤖 **{len(to_analyze)}** emails flagged for AI Deep Analysis.")

            # --- PHASE 2: PARALLEL AI PROCESSING ---
            if not to_analyze.empty:
                results = []
                tasks = []
                # Build task list for threading
                for idx, row in to_analyze.iterrows():
                    tasks.append((idx, "Batch Context", row[s_col], row[b_col]))

                progress_bar = st.progress(0)
                status_text = st.empty()
                
                # Execute parallel calls to LLM
                with ThreadPoolExecutor(max_workers=parallel_workers) as executor:
                    for i, result in enumerate(executor.map(engine.analyze_single_llm_call, tasks)):
                        if result and "category" in result:
                            # Map original data back to alert
                            orig_row = to_analyze.loc[result['original_index']]
                            result['sender'] = orig_row[sender_col]
                            result['receiver'] = orig_row[rec_col]
                            result['subject'] = orig_row[s_col]
                            result['timestamp'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                            results.append(result)
                        
                        progress_bar.progress((i + 1) / len(tasks))
                        status_text.text(f"AI Worker: Reviewing {i+1} of {len(tasks)} suspicious items...")

                duration = time.time() - start_time
                st.success(f"Pipeline finished in **{duration:.2f} seconds**.")
                
                if results:
                    st.session_state.alerts.extend(results)
                    res_df = pd.DataFrame(results)
                    st.warning(f"Found {len(results)} Potential Non-Compliance Violations.")
                    st.dataframe(res_df[['priority', 'category', 'sender', 'subject', 'reason', 'evidence_line']])
                    st.download_button("📥 Download Alert Report", res_df.to_csv(index=False), "compliance_alerts.csv")
                else:
                    st.success("All items cleared. No violations found.")
            else:
                st.success("All communications cleared by Stage 1 local filtering.")

# --- TAB 3: ALERT DASHBOARD ---
with tab3:
    st.subheader("Compliance Officer Worklist")
    
    if not st.session_state.alerts:
        st.info("The review queue is currently empty.")
    else:
        df_alerts = pd.DataFrame(st.session_state.alerts).sort_values(by='priority', ascending=False)
        
        # Overview Metrics
        m1, m2, m3 = st.columns(3)
        m1.metric("Total Alerts", len(df_alerts))
        m2.metric("Critical (Priority > 8.0)", len(df_alerts[df_alerts['priority'] >= 8]))
        m3.metric("Avg Risk Score", f"{df_alerts['priority'].mean():.1f}")
        
        st.divider()
        
        # Interactive Dashboard Table
        st.dataframe(
            df_alerts,
            column_config={
                "priority": st.column_config.ProgressColumn("Priority", min_value=0, max_value=10, format="%.1f"),
                "timestamp": "Time Detected",
                "category": "Violation Type",
                "evidence_line": st.column_config.TextColumn("Source Line", width="large")
            },
            hide_index=True,
            use_container_width=True
        )

        if st.button("🗑️ Clear Review Queue"):
            st.session_state.alerts = []
            st.rerun()
