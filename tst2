# --- MAIN UI ---
st.title("🛡️ Enterprise AI Compliance System")
st.markdown("Autonomous intent detection with automated parsing and mapping.")

tab1, tab2, tab3 = st.tabs(["🕒 Manual Raw Scan", "🚀 Autonomous Batch Ingestion", "📊 Alert Dashboard"])

# --- TAB 1: MANUAL RAW SCAN (AI Parsing) ---
with tab1:
    st.subheader("Paste Raw Communication")
    st.write("System will automatically separate Subject and Body using AI.")
    
    raw_input = st.text_area("Paste full email here...", height=250, placeholder="Example: Subject: Urgent. Hi Team, delete this later but...")
    
    col1, col2, col3 = st.columns(3)
    m_sender = col1.text_input("Sender", "employee@bank.com")
    m_receiver = col2.text_input("Receiver", "client@external.com")
    m_thread = col3.text_input("Thread ID", "TR-Manual")

    if st.button("🚀 Analyze Raw Email"):
        if not raw_input.strip():
            st.warning("Please paste an email.")
        else:
            with st.status("AI Parsing & Analyzing...", expanded=True) as status:
                # Step 1: Split raw text into Subject and Body
                st.write("🛠️ AI Parsing metadata...")
                parsed = engine.extract_subject_body(raw_input)
                st.info(f"**AI Detected Subject:** {parsed['subject']}")
                
                # Step 2: Thread Context
                context = " | ".join(st.session_state.thread_history.get(m_thread, [])[-3:])
                
                # Step 3: Pipeline Check
                if engine.pre_filter(parsed['subject'], parsed['body']):
                    st.warning("Communication identified as Noise.")
                else:
                    ml_risk = engine.ml_risk_scoring(parsed['subject'], parsed['body'])
                    if ml_risk >= risk_trigger:
                        st.write("🤖 Running Intent Reasoning...")
                        res = engine.analyze_single_llm_call((0, context, parsed['subject'], parsed['body']))
                        if res and res.get("flagged"):
                            res.update({"timestamp": datetime.now().strftime("%H:%M:%S"), "sender": m_sender, "subject": parsed['subject']})
                            st.session_state.alerts.insert(0, res)
                            st.error(f"🚨 Violation Detected: {res['category']} (Priority: {res['priority']})")
                        else:
                            st.success("No malicious intent found.")
                    else:
                        st.success("Heuristic score low. No violation.")
                status.update(label="Scan Complete", state="complete")

# --- TAB 2: AUTONOMOUS BATCH INGESTION (5000+ Data) ---
with tab2:
    st.subheader("Autonomous Bulk Pipeline")
    st.info("Zero Human-in-Loop: Upload your file and the AI will auto-map columns and process in parallel.")
    
    up_file = st.file_uploader("Upload CSV or Excel", type=['csv', 'xlsx'])
    
    if up_file:
        df = pd.read_csv(up_file) if up_file.name.endswith('.csv') else pd.read_excel(up_file)
        st.write(f"📂 Found **{len(df)}** records.")
        
        # Automatic Mapping
        mapping = autonomous_map_columns(df.columns.tolist())
        
        st.write("### 🤖 Autonomous Mapping Results:")
        # Display the mapping to the user so they see the AI's logic
        map_df = pd.DataFrame([mapping]).T.rename(columns={0: "Matched CSV Column"})
        st.table(map_df)

        if st.button("🚀 Run High-Speed Autonomous Pipeline"):
            start_time = time.time()
            
            # Phase 1: Local Water-fall Filter
            st.write("🔍 Phase 1: Local Heuristic Filtering...")
            df['is_noise'] = df.apply(lambda r: engine.pre_filter(r[mapping['subject']], r[mapping['body']]), axis=1)
            df['ml_score'] = df.apply(lambda r: engine.ml_risk_scoring(r[mapping['subject']], r[mapping['body']]), axis=1)
            
            to_analyze = df[(df['is_noise'] == False) & (df['ml_score'] >= risk_trigger)].copy()
            st.write(f"✅ Skipped {len(df)-len(to_analyze)} safe rows. AI Deep Analysis required for {len(to_analyze)} rows.")

            # Phase 2: Parallel LLM Reasoning
            if not to_analyze.empty:
                results = []
                tasks = []
                for idx, row in to_analyze.iterrows():
                    tasks.append((idx, "Batch Process", row[mapping['subject']], row[mapping['body']]))

                progress = st.progress(0)
                status_msg = st.empty()
                
                with ThreadPoolExecutor(max_workers=workers) as executor:
                    for i, res in enumerate(executor.map(engine.analyze_single_llm_call, tasks)):
                        if res and "category" in res:
                            orig = to_analyze.loc[res['original_index']]
                            res.update({
                                "sender": orig[mapping['sender']],
                                "subject": orig[mapping['subject']],
                                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                            })
                            results.append(res)
                        progress.progress((i + 1) / len(tasks))
                        status_msg.text(f"Processed {i+1}/{len(tasks)} suspicious items...")

                st.success(f"Pipeline Finished in {time.time() - start_time:.2f} seconds.")
                if results:
                    st.session_state.alerts.extend(results)
                    st.dataframe(pd.DataFrame(results))
                    st.download_button("Download Alert Report", pd.DataFrame(results).to_csv(index=False), "compliance_alerts.csv")
            else:
                st.success("No violations found in batch.")

