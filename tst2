import streamlit as st
import pandas as pd
import json
import time
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor
from ComplianceEngine import ComplianceEngine

# --- PAGE CONFIGURATION ---
st.set_page_config(
    page_title="High-Speed AI Compliance Surveillance",
    page_icon="🛡️",
    layout="wide"
)

# Initialize the High-Performance Engine
# Using cache_resource ensures the requests.Session is reused for connection pooling
@st.cache_resource
def get_engine():
    return ComplianceEngine()

engine = get_engine()

# --- SESSION STATE ---
if 'alerts' not in st.session_state:
    st.session_state.alerts = []
if 'thread_history' not in st.session_state:
    st.session_state.thread_history = {}

# --- SIDEBAR: OPERATIONAL CONTROLS ---
st.sidebar.title("⚙️ System Controls")

risk_threshold = st.sidebar.slider(
    "ML Risk Trigger (Gatekeeper)", 
    0.0, 1.0, 0.4, 
    help="Higher = Faster (fewer LLM calls). Lower = More sensitive (more AI reasoning)."
)

parallel_threads = st.sidebar.slider(
    "Parallel AI Workers", 
    5, 50, 20, 
    help="Number of simultaneous AI requests. Increase for 5000+ records, but watch for API rate limits."
)

st.sidebar.divider()
st.sidebar.subheader("Priority Weightage")
st.sidebar.table(pd.DataFrame(list(engine.matrix.items()), columns=['Category', 'Weight']))

# --- MAIN UI ---
st.title("🛡️ Enterprise Communication Surveillance")
st.markdown("Multi-layered AI system for identifying Market Manipulation and Misconduct.")

tab1, tab2, tab3 = st.tabs(["🕒 Real-time Monitor", "🚀 High-Speed Batch Ingestion", "📊 Alert Dashboard"])

# --- TAB 1: REAL-TIME MONITOR ---
with tab1:
    st.subheader("Single Communication Analysis")
    with st.form("manual_entry"):
        col1, col2 = st.columns(2)
        sender = col1.text_input("Employee Email", "emp_01@bank.com")
        receiver = col2.text_input("External Party", "trader@hedgefund.com")
        subject = st.text_input("Subject Line")
        thread_id = st.text_input("Thread ID", "TR-1001")
        body = st.text_area("Email Content")
        
        analyze_btn = st.form_submit_button("Analyze Intent")

    if analyze_btn:
        if not body or not subject:
            st.warning("Please provide both Subject and Body.")
        else:
            with st.status("Analyzing...", expanded=True) as status:
                # Context
                context = " | ".join(st.session_state.thread_history.get(thread_id, [])[-3:])
                
                # Layer 1: Filter
                if engine.pre_filter(subject, body):
                    st.info("System Filter: Non-substantive communication (Noise).")
                else:
                    # Layer 2: ML Score
                    ml_risk = engine.ml_risk_scoring(subject, body)
                    st.write(f"Heuristic Risk Score: {ml_risk:.2f}")
                    
                    if ml_risk >= risk_threshold:
                        # Layer 3: LLM
                        st.write("🤖 Deep AI Intent Analysis...")
                        raw = engine.analyze_single_llm_call((0, context, subject, body))
                        if raw and not raw.get("error"):
                            st.error(f"🚨 Potential Violation: {raw['category']}")
                            st.write(f"**Reasoning:** {raw['reason']}")
                            st.write(f"**Source Evidence:** `{raw['evidence_line']}`")
                            
                            # Log Alert
                            raw['timestamp'] = datetime.now().strftime("%H:%M:%S")
                            raw['subject'] = subject
                            raw['sender'] = sender
                            st.session_state.alerts.insert(0, raw)
                        else:
                            st.success("AI Analysis: Communication is Compliant.")
                    else:
                        st.success("Risk below threshold. Automated approval.")
                status.update(label="Analysis Complete", state="complete")

# --- TAB 2: HIGH-SPEED BATCH INGESTION (5000+ Records) ---
with tab2:
    st.subheader("Bulk Surveillance Pipeline")
    st.info("Optimized for large datasets. Phase 1: Local Filtering. Phase 2: Parallel AI Reasoning.")
    
    up_file = st.file_uploader("Upload CSV or Excel", type=['csv', 'xlsx'])
    
    if up_file:
        df = pd.read_csv(up_file) if up_file.name.endswith('.csv') else pd.read_excel(up_file)
        st.write(f"📂 Loaded **{len(df)}** records.")
        
        st.divider()
        st.write("### Map Your Data Columns")
        cols = df.columns.tolist()
        c1, c2, c3, c4, c5 = st.columns(5)
        subj_col = c1.selectbox("Subject", cols, index=0 if 'subject' in str(cols).lower() else 0)
        body_col = c2.selectbox("Body/Content", cols, index=0 if 'body' in str(cols).lower() else 0)
        sender_col = c3.selectbox("Sender", cols)
        rec_col = c4.selectbox("Receiver", cols)
        thread_col = c5.selectbox("Thread ID", cols)

        if st.button("🚀 Run High-Speed Pipeline"):
            start_time = time.time()
            
            # --- PHASE 1: LOCAL WATERFALL FILTERING (Instant) ---
            st.write("🔍 Phase 1: Running Local Heuristic Filters...")
            
            # Vectorized local check
            df['is_noise'] = df.apply(lambda r: engine.pre_filter(r[subj_col], r[body_col]), axis=1)
            df['ml_score'] = df.apply(lambda r: engine.ml_risk_scoring(r[subj_col], r[body_col]), axis=1)
            
            # Subset only suspicious ones
            suspicious_df = df[(df['is_noise'] == False) & (df['ml_score'] >= risk_threshold)].copy()
            
            st.write(f"✅ Filtered **{len(df) - len(suspicious_df)}** safe emails.")
            st.write(f"🤖 **{len(suspicious_df)}** emails requiring Deep AI Analysis...")

            # --- PHASE 2: PARALLEL LLM REASONING ---
            if not suspicious_df.empty:
                results = []
                # Prepare parallel tasks
                tasks = []
                for idx, row in suspicious_df.iterrows():
                    tasks.append((idx, "Batch Process", row[subj_col], row[body_col]))

                progress_bar = st.progress(0)
                status_text = st.empty()
                
                with ThreadPoolExecutor(max_workers=parallel_threads) as executor:
                    # Parallel Map
                    for i, result in enumerate(executor.map(engine.analyze_single_llm_call, tasks)):
                        if result and "category" in result:
                            # Add metadata back
                            orig_row = suspicious_df.loc[result['original_index']]
                            result['sender'] = orig_row[sender_col]
                            result['receiver'] = orig_row[rec_col]
                            result['subject'] = orig_row[subj_col]
                            result['timestamp'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                            results.append(result)
                        
                        progress_bar.progress((i + 1) / len(tasks))
                        status_text.text(f"AI Reviewing: {i+1}/{len(tasks)} (Found {len(results)} violations)")

                # Wrap Up
                duration = time.time() - start_time
                st.success(f"Processing Complete in **{duration:.2f} seconds**.")
                
                if results:
                    st.session_state.alerts.extend(results)
                    res_df = pd.DataFrame(results)
                    st.warning(f"Total Violations Identified: {len(results)}")
                    st.dataframe(res_df[['priority', 'category', 'sender', 'subject', 'reason', 'evidence_line']])
                    st.download_button("Download Alert Report", res_df.to_csv(index=False), "batch_alerts.csv")
                else:
                    st.success("No violations found.")
            else:
                st.success("All emails cleared by local heuristic filters.")

# --- TAB 3: ALERT DASHBOARD ---
with tab3:
    st.subheader("Compliance Officer Worklist")
    
    if not st.session_state.alerts:
        st.info("No alerts found in system.")
    else:
        df_alerts = pd.DataFrame(st.session_state.alerts).sort_values(by='priority', ascending=False)
        
        # Dashboard Metrics
        m1, m2, m3 = st.columns(3)
        m1.metric("Total Alerts", len(df_alerts))
        m2.metric("Critical (Score > 8)", len(df_alerts[df_alerts['priority'] >= 8]))
        m3.metric("Avg Priority", f"{df_alerts['priority'].mean():.1f}")
        
        st.divider()
        
        # Interactive Table
        st.dataframe(
            df_alerts,
            column_config={
                "priority": st.column_config.ProgressColumn("Priority Score", min_value=0, max_value=10, format="%.1f"),
                "timestamp": "Detected At",
                "category": "Violation Type",
                "evidence_line": st.column_config.TextColumn("Source Evidence", width="large")
            },
            hide_index=True,
            use_container_width=True
        )

        if st.button("🗑️ Clear All Alerts"):
            st.session_state.alerts = []
            st.rerun()
