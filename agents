from langchain_openai import AzureChatOpenAI
from langchain.prompts import ChatPromptTemplate
import os

class ValidationRefactoringAgent:
    def __init__(self):
        self.llm = AzureChatOpenAI(
            azure_deployment=os.getenv("AZURE_OPENAI_DEPLOYMENT_NAME"),
            api_key=os.getenv("AZURE_OPENAI_API_KEY"),
            azure_endpoint=os.getenv("AZURE_OPENAI_ENDPOINT"),
            openai_api_version=os.getenv("AZURE_OPENAI_API_VERSION"),
            temperature=0
        )

    def finalize_code(self, context: str, spec: str, target_lang: str):
        """Step 7: Final synthesis and refactoring."""
        prompt = ChatPromptTemplate.from_messages([
            ("system", f"You are a Senior {target_lang} Developer. Implement the logic using modern design patterns."),
            ("user", "Context: {context}\nLogic Spec: {spec}\nGenerate clean code.")
        ])
        chain = prompt | self.llm
        return chain.invoke({"context": context, "spec": spec, "target_lang": target_lang}).content
