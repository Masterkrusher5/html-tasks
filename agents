import os
from dotenv import load_dotenv
from langchain_openai import ChatOpenAI
from langchain_core.prompts import ChatPromptTemplate

load_dotenv()

class ValidationRefactoringAgent:
    def __init__(self):
        self.llm = ChatOpenAI(
            base_url=os.getenv("LLM_ENDPOINT"),
            api_key=os.getenv("LLM_API_KEY"),
            model="gpt-4",
            temperature=0
        )

    def finalize_code(self, context: str, spec: str, target_lang: str):
        prompt = ChatPromptTemplate.from_messages([
            ("system", f"You are a Senior {target_lang} Developer. Focus on modularity and clean code."),
            ("user", "Context from Shared Libraries: {context}\nLogic Specification: {spec}\n\n"
                     "Rewrite this into a runnable {target_lang} service.")
        ])
        chain = prompt | self.llm
        return chain.invoke({"context": context, "spec": spec, "target_lang": target_lang}).content
