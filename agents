import os
import json
import requests
import re
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ValidationRefactoringAgent:
    """
    Phase 2, 3 & 4 Agent: Handles Forensic Documentation, Synthesis, and Testing.
    Communicates via direct HTTP requests to a generic LLM Endpoint.
    """
    def __init__(self):
        # API Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            raise ValueError("LLM_ENDPOINT or LLM_KEY not found in environment variables.")
        
        # Connection Pooling for high performance
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key  # Use "Authorization": f"Bearer {self.api_key}" if required by your gateway
        })

    def _sanitize_json(self, text: str) -> dict:
        """Helper to extract JSON from LLM response strings."""
        try:
            # Look for markdown JSON blocks first
            match = re.search(r'```json\s*(.*?)\s*```', text, re.DOTALL)
            if match:
                return json.loads(match.group(1))
            
            # Look for the first { and last }
            start_idx = text.find("{")
            end_idx = text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                return json.loads(text[start_idx : end_idx + 1])
            
            return json.loads(text)
        except Exception:
            return {
                "summary": "Parsing Error",
                "description": "The LLM did not return a valid JSON object.",
                "functions": [],
                "confidence_score": 0.0
            }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Extracts granular technical specs from the legacy code.
        """
        prompt = f"""
        Act as a Principal Systems Architect. Perform an exhaustive forensic analysis of the following legacy code.
        SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Return ONLY a JSON object with exactly these keys:
        summary, description, functions (list of {{name, purpose, logic_explanation, inputs_outputs, business_rules}}), 
        data_dictionary (list of {{variable, type, role}}), dependencies, complexity_rating, 
        confidence_score, auto_approval_status.
        """
        
        payload = {
            "messages": [
                {"role": "system", "content": "You are a senior forensic analyst. Output strictly valid JSON."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=90)
            response.raise_for_status()
            res_data = response.json()
            content = res_data['choices'][0]['message']['content']
            return self._sanitize_json(content)
        except Exception as e:
            return {
                "summary": "Analysis Connection Error",
                "description": f"Failed to reach LLM: {str(e)}",
                "functions": [],
                "confidence_score": 0.0
            }

    # --- LLM STREAMING ENGINE (SSE Parser) ---

    def stream_llm(self, prompt: str):
        """
        Standardized SSE (Server-Sent Events) parser for streaming tokens to UI.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. Provide only high-quality source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0,
            "stream": True 
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as response:
                response.raise_for_status()
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:] # Remove 'data: ' prefix
                        
                        if content_raw == "[DONE]":
                            break
                        
                        try:
                            chunk_json = json.loads(content_raw)
                            delta = chunk_json['choices'][0].get('delta', {})
                            if 'content' in delta:
                                yield delta['content']
                        except:
                            continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PROMPT GENERATORS ---

    def get_synthesis_prompt(self, doc_data: dict, target_lang: str) -> str:
        constraints = ""
        if "Java" in target_lang:
            constraints = "Use Vanilla Java 17+, standard libraries only. NO Spring Boot/Annotations."
        
        return f"""
        TASK: Synthesize a cohesive {target_lang} file from this forensic spec:
        {json.dumps(doc_data)}
        
        CONSTRAINTS:
        {constraints}
        - Maintain exact business formulas and logical branching.
        - Return ONLY the full source code.
        """

    def get_test_prompt(self, modern_code: str, target_lang: str) -> str:
        framework = "JUnit 5" if "Java" in target_lang else "pytest"
        return f"""
        TASK: Generate a single {framework} test file for this code:
        {modern_code}
        Return ONLY the test code content.
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Dashboard logic."""
        conf = doc_data.get('confidence_score', 0)
        auto = doc_data.get('auto_approval_status', False)
        zone, color = ("GREEN", "green") if (auto and conf >= 0.85) else (("AMBER", "orange") if conf >= 0.6 else ("RED", "red"))
        return {"zone": zone, "color": color, "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 'N/A')}
