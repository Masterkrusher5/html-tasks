import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ValidationRefactoringAgent:
    """
    Phase 3 & 4 Agent: Unified Code Synthesis and Validation.
    Refactored for Azure OpenAI direct endpoint streaming.
    Enforces Vanilla Java and Multi-Language support.
    """
    def __init__(self):
        # Configuration from working Azure setup
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection Pooling for high-concurrency streaming
        self.session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(
            pool_connections=20, 
            pool_maxsize=20,
            max_retries=3
        )
        self.session.mount('https://', adapter)
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def stream_llm(self, prompt: str):
        """
        Direct Azure SSE (Server-Sent Events) streaming parser.
        Yields content character-by-character for real-time UI updates.
        """
        payload = {
            "messages": [
                {
                    "role": "system", 
                    "content": "You are a Senior Software Architect specializing in legacy modernization."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ],
            "temperature": 0,
            "stream": True 
        }

        try:
            # We use stream=True for real-time token delivery
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as response:
                response.raise_for_status()
                
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:] # Strip 'data: ' prefix
                        
                        if content_raw == "[DONE]":
                            break
                        
                        try:
                            chunk_json = json.loads(content_raw)
                            if chunk_json.get('choices'):
                                delta = chunk_json['choices'][0].get('delta', {})
                                if 'content' in delta:
                                    yield delta['content']
                        except (json.JSONDecodeError, KeyError):
                            continue
                            
        except Exception as e:
            yield f"\n[TRANSFORMATION_ERROR: {str(e)}]"

    # --- PHASE 3: UNIFIED CODE SYNTHESIS PROMPT ---

    def get_unified_synthesis_prompt(self, context_doc: dict, target_lang: str) -> str:
        """
        Builds a language-specific synthesis prompt. 
        Enforces Vanilla Java 17+ (No Spring Boot) if Java is selected.
        """
        # Specific constraints for Vanilla Java vs other languages
        constraints = ""
        if "Java" in target_lang:
            constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use @Service, @Autowired, @Component, etc.\n"
                "- NO EXTERNAL FRAMEWORKS: Use standard JDK libraries only (java.util, java.math, java.time).\n"
                "- Structure: Single cohesive public class with a meaningful name."
            )
        elif "Python" in target_lang:
            constraints = "- Target: Python 3.10+.\n- Use Type Hints and standard libraries.\n- Structure: Single clean module."
        elif "C#" in target_lang:
            constraints = "- Target: .NET Core 6+.\n- Structure: Single cohesive class with file-scoped namespaces."
        else:
            constraints = f"- Use idiomatic standards for {target_lang}."

        return f"""
        TASK: Synthesize a modern, production-ready {target_lang} source file from the 
        provided Forensic Specification.
        
        FORENSIC SPECIFICATION:
        \"\"\"{json.dumps(context_doc)}\"\"\"
        
        CONSTRAINTS:
        {constraints}
        - Preserve ALL business logic, mathematical formulas, and conditional branching exactly as identified in the spec.
        - Refactor procedural 'spaghetti' logic into modular, clean methods.
        - Handle Data Mapping according to the provided Data Dictionary.
        - Return ONLY the full code content inside a single file.
        """

    # --- PHASE 4: UNIFIED UNIT TEST PROMPT ---

    def get_unified_test_prompt(self, modern_code: str, target_lang: str) -> str:
        """
        Maps the target language to the appropriate testing framework.
        """
        # Framework Mapping
        framework_map = {
            "Java": "JUnit 5",
            "Python": "pytest",
            "C#": "xUnit",
            "TypeScript": "Jest"
        }
        
        base_lang = target_lang.split()[0] # e.g., "Java (Vanilla)" -> "Java"
        framework = framework_map.get(base_lang, "standard testing library")
        
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the provided {target_lang} code.
        
        CODE TO TEST:
        \"\"\"{modern_code}\"\"\"
        
        REQUIREMENTS:
        1. Use {framework} assertions.
        2. Include test cases for successful execution and boundary/edge cases identified in the logic.
        3. Use standard mocking patterns if external file/IO dependencies were synthesized.
        4. Return ONLY the test code content.
        """

    # --- PHASE 4: AUTO-CORRECTION (Reflection) ---

    def refine_code(self, code: str, error_log: str, target_lang: str):
        """
        Self-correction loop if the generated code has syntax or logical errors.
        """
        prompt = f"""
        The following {target_lang} code has errors. Fix them while maintaining business rules.
        ERROR: {error_log}
        CODE: {code}
        """
        full_fix = ""
        for delta in self.stream_llm(prompt):
            full_fix += delta
        return full_fix
