import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ValidationRefactoringAgent:
    """
    Phase 3 & 4 Agent: Handles Synthesis and Testing.
    Optimized for Parallel Streaming and high-concurrency requests.
    """
    def __init__(self):
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection Pooling: Critical for parallel streaming to avoid bottlenecks
        self.session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(
            pool_connections=50, 
            pool_maxsize=50,
            max_retries=2
        )
        self.session.mount('https://', adapter)
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def stream_llm(self, prompt: str):
        """
        A generator that streams data from the Azure OpenAI endpoint.
        Parses SSE (Server-Sent Events) for real-time UI updates.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Software Architect. Output only high-quality, runnable code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0,
            "stream": True  # Enable Azure OpenAI Streaming
        }

        try:
            # We use stream=True and a timeout to ensure responsiveness
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=60) as response:
                response.raise_for_status()
                
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    # Azure sends chunks prefixed with 'data: '
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:] # Strip 'data: '
                        
                        if content_raw == "[DONE]":
                            break
                        
                        try:
                            chunk_json = json.loads(content_raw)
                            if chunk_json.get('choices'):
                                delta = chunk_json['choices'][0].get('delta', {})
                                if 'content' in delta:
                                    yield delta['content']
                        except (json.JSONDecodeError, KeyError):
                            continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PROMPT GENERATORS (Required by app.py) ---

    def get_synthesis_prompt(self, context: str, spec: str, target_tech: str) -> str:
        """Constructs the prompt for Phase 3: Code Synthesis."""
        return f"""
        TASK: Synthesize modern, clean {target_tech} code from legacy logic specs.
        
        CONTEXT FROM SHARED LIBRARIES:
        \"\"\"{context}\"\"\"
        
        BUSINESS LOGIC SPECIFICATION:
        \"\"\"{spec}\"\"\"
        
        STANDARDS:
        - Use SOLID principles.
        - Implement robust error handling.
        - Output ONLY the code, no conversational filler.
        - Use modern frameworks (e.g., FastAPI for Python, Spring Boot for Java).
        """

    def get_test_prompt(self, modern_code: str, target_tech: str) -> str:
        """Constructs the prompt for Phase 4: Unit Testing."""
        framework = "JUnit 5" if "java" in target_tech.lower() else "pytest"
        return f"""
        TASK: Generate comprehensive {framework} unit tests for the modernized code.
        
        CODE TO TEST:
        \"\"\"{modern_code}\"\"\"
        
        INSTRUCTIONS:
        - Test edge cases and primary logic paths.
        - Mock external dependencies where required.
        - Return ONLY the test source code.
        """

    # --- HELPER FOR NON-STREAMING (Synchronous) ---
    
    def finalize_code_sync(self, context, spec, target_tech):
        """Collects the full stream into a single string for internal processing."""
        prompt = self.get_synthesis_prompt(context, spec, target_tech)
        full_code = ""
        for chunk in self.stream_llm(prompt):
            full_code += chunk
        return full_code

    # --- PHASE 4: AUTO-CORRECTION (Reflection Loop) ---
    def refine_code_from_feedback(self, code, error_log, target_tech):
        """Self-Correction logic for Phase 4 validation failures."""
        prompt = f"""
        The following {target_tech} code failed execution/validation.
        
        ERROR LOG: {error_log}
        CODE:
        {code}
        
        Fix the error and return corrected code only.
        """
        full_refinement = ""
        for chunk in self.stream_llm(prompt):
            full_refinement += chunk
        return full_refinement
