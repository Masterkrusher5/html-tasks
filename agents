import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ValidationRefactoringAgent:
    """
    Phase 3 & 4 Agent: Unified Code Synthesis and Validation.
    Supports multi-language conversion (Java, Python, C#, TypeScript) 
    and handles single-file cohesive transformations.
    """
    def __init__(self):
        # API Configuration
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection Pooling optimized for high-concurrency and long-duration synthesis
        self.session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(
            pool_connections=20, 
            pool_maxsize=20,
            max_retries=3
        )
        self.session.mount('https://', adapter)
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def stream_llm(self, prompt: str, target_lang: str):
        """
        Standardized Azure OpenAI SSE (Server-Sent Events) streaming parser.
        Dynamically adjusts persona based on the target language.
        """
        # Set specific persona for the target language
        system_persona = f"You are a Senior {target_lang} Software Architect specializing in legacy modernization."
        
        payload = {
            "messages": [
                {
                    "role": "system", 
                    "content": f"{system_persona} Output only high-quality, production-ready source code. "
                               "Maintain exact business logic and follow modern best practices for the language."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ],
            "temperature": 0,
            "stream": True 
        }

        try:
            # Longer timeout for large unified file generation
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as response:
                response.raise_for_status()
                
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:] # Strip 'data: '
                        
                        if content_raw == "[DONE]":
                            break
                        
                        try:
                            chunk_json = json.loads(content_raw)
                            if chunk_json.get('choices'):
                                delta = chunk_json['choices'][0].get('delta', {})
                                if 'content' in delta:
                                    yield delta['content']
                        except (json.JSONDecodeError, KeyError):
                            continue
                            
        except Exception as e:
            yield f"\n[TRANSFORMATION_ERROR: {str(e)}]"

    # --- PHASE 3: UNIFIED CODE SYNTHESIS PROMPT ---

    def get_unified_synthesis_prompt(self, context: str, original_code: str, target_lang: str) -> str:
        """
        Builds a language-specific synthesis prompt for unified file generation.
        """
        # Determine language-specific constraints
        constraints = ""
        if "Java" in target_lang:
            constraints = (
                "- Use Vanilla Java 17+. \n"
                "- NO SPRING BOOT: Do not use @Service, @Autowired, etc.\n"
                "- Use Standard JDK libraries only (java.util, java.math, etc.)."
            )
        elif "Python" in target_lang:
            constraints = (
                "- Use Python 3.10+.\n"
                "- Include PEP 484 Type Hints.\n"
                "- Use Pydantic for data validation if appropriate.\n"
                "- Maintain idiomatic 'Pythonic' style."
            )
        elif "C#" in target_lang:
            constraints = (
                "- Use .NET 6/7/8.\n"
                "- Use File-scoped namespaces and primary constructors if applicable.\n"
                "- Use C# standard naming conventions."
            )
        elif "TypeScript" in target_lang:
            constraints = (
                "- Use TypeScript 5+.\n"
                "- Use ES Modules (import/export).\n"
                "- Define strict Interfaces/Types for all data structures."
            )

        return f"""
        TASK: Transform the provided legacy source code into a SINGLE cohesive {target_lang} file.
        
        BUSINESS LOGIC SPECIFICATION:
        \"\"\"{context}\"\"\"
        
        LEGACY SOURCE CODE:
        \"\"\"{original_code}\"\"\"
        
        CONSTRAINTS:
        {constraints}
        - Maintain the EXACT business logic and calculation formulas.
        - Decouple procedural legacy flow into clean, modular methods.
        - Provide the FULL source code content only.
        """

    # --- PHASE 4: UNIFIED UNIT TEST PROMPT ---

    def get_unified_test_prompt(self, modern_code: str, target_lang: str) -> str:
        """
        Maps the target language to the appropriate testing framework.
        """
        # Framework Mapping
        framework_map = {
            "Java": "JUnit 5",
            "Python": "pytest",
            "C#": "xUnit",
            "TypeScript": "Jest",
            "JavaScript": "Mocha"
        }
        
        # Extract base name to match framework (e.g., "Python (FastAPI)" -> "Python")
        base_lang = target_lang.split()[0]
        framework = framework_map.get(base_lang, "standard testing library")
        
        return f"""
        TASK: Generate a single comprehensive {framework} unit test file for the provided {target_lang} code.
        
        CODE TO TEST:
        \"\"\"{modern_code}\"\"\"
        
        REQUIREMENTS:
        1. Use {framework} for all assertions.
        2. Include test cases for success paths and edge cases (e.g., nulls, zero values, boundaries).
        3. Mock external dependencies (DB/Files) if present in the code.
        4. Provide the FULL test code content only.
        """

    # --- PHASE 4: AUTO-CORRECTION (Reflection Loop) ---

    def refine_unified_code(self, code: str, error_log: str, target_lang: str):
        """
        Self-correction agent used to fix syntax or logical errors in the generated code.
        """
        prompt = f"""
        The following {target_lang} code has errors. 
        Fix the code while preserving the business logic.
        
        ERROR LOG: {error_log}
        CODE: {code}
        """
        full_refinement = ""
        for chunk in self.stream_llm(prompt, target_lang):
            full_refinement += chunk
        return full_refinement
