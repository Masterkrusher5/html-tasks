from pydantic import BaseModel, Field
from typing import List, Dict, Optional, Any

# --- PHASE 1: INGESTION METADATA ---

class FileMetadata(BaseModel):
    """
    Metadata for the legacy file ingested in Phase 1.
    Used to populate the initial scan results in the UI.
    """
    file_name: str
    extension: str
    detected_language: str
    size_kb: float
    role: str = Field(description="Entry Program or Shared Library")
    line_count: int

# --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

class DataMapping(BaseModel):
    """
    Entry for the Forensic Data Dictionary.
    Maps cryptic legacy variables (e.g. WS-RT-01) to readable business roles.
    """
    variable: str = Field(description="Legacy variable name")
    type: str = Field(description="Inferred or declared data type")
    role: str = Field(description="Meaning/Role within the business logic")

class ForensicFunction(BaseModel):
    """
    Detailed breakdown of a legacy procedure, paragraph, or function.
    Provides the 'granular explanation' requested.
    """
    name: str = Field(description="Formal identifier of the logic block")
    purpose: str = Field(description="High-level functional goal")
    logic_explanation: str = Field(description="Step-by-step breakdown of the internal logic")
    inputs_outputs: str = Field(description="Variables, files, or buffers accessed")
    business_rules: str = Field(description="Specific financial or logical rules enforced here")

class ComprehensiveForensicDoc(BaseModel):
    """
    The 'Micro-Spec' or Living Documentation.
    The primary source of truth extracted from voluminous legacy code.
    """
    summary: str = Field(description="Professional executive summary of the module")
    description: str = Field(description="Comprehensive multi-paragraph deep-dive into the business logic")
    functions: List[ForensicFunction] = Field(description="List of all detected logical blocks")
    data_dictionary: List[DataMapping] = Field(description="Mapping of legacy fields to business roles")
    dependencies: List[str] = Field(description="External files, databases, or libraries referenced")
    complexity_rating: int = Field(ge=1, le=10, description="1-10 spaghetti/complexity factor")
    confidence_score: float = Field(ge=0.0, le=1.0, description="AI confidence in analysis accuracy")
    auto_approval_status: bool = Field(description="True if logic is clear for auto-modernization")

# --- PHASE 3: MODERNIZATION & TESTING ---

class ModernizationResult(BaseModel):
    """
    The final output container for the unified transformation.
    """
    target_language: str
    modern_code: str = Field(description="The full, unified source code")
    unit_tests: str = Field(description="The comprehensive unit test suite")
    manual_review_notes: Optional[List[str]] = Field(default_factory=list)

# --- PHASE 4: DASHBOARD METRICS ---

class DashboardMetrics(BaseModel):
    """
    Data structure for the Evaluation Dashboard heatmap and metrics.
    """
    zone: str = Field(description="GREEN, AMBER, or RED based on risk")
    color: str = Field(description="CSS class or Hex for the status color")
    confidence_pct: str
    complexity: Any = Field(description="Complexity score or label")
