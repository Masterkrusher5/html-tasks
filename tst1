import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ComplianceEngine:
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # 1. Connection Pooling: Faster than making new requests for every email
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })
        
        # 2. Predefined Priority Matrix (Weightage)
        self.matrix = {
            "Market Manipulation": 10,
            "Insider Trading": 10,
            "Quid Pro Quo": 9,
            "Front Running": 9,
            "Secrecy": 7,
            "Policy Violation": 3,
            "Compliant": 0
        }

    # --- STAGE 1: PRE-FILTERING (Ultra Fast) ---
    def pre_filter(self, subject, body):
        """Identifies automated noise, newsletters, and system messages locally."""
        noise_patterns = [
            r"unsubscribe", r"automatic reply", r"out of office", 
            r"newsletter", r"mailing list", r"noreply@", r"system alert"
        ]
        # Combine subject and body for a single scan
        text_to_scan = f"{str(subject)} {str(body)}".lower()
        return any(re.search(pattern, text_to_scan) for pattern in noise_patterns)

    # --- STAGE 2: HEURISTIC & BEHAVIOURAL SCREENING ---
    def heuristic_score(self, email_data):
        """Checks for behavioral anomalies (external domains, etc.)."""
        score = 0.0
        receiver = str(email_data.get('receiver', '')).lower()
        # Flag if the receiver is not an internal bank employee
        if receiver and not receiver.endswith('@yourbank.com'):
            score += 0.5
        return score

    # --- STAGE 3: ML RISK SCORING (Vectorized/Keyword Check) ---
    def ml_risk_scoring(self, subject, body):
        """Preliminary Intent check to see if we should 'spend' an LLM call."""
        risk_keywords = [
            "guarantee", "off the record", "delete this", "wire transfer", 
            "allocation", "favorable", "confidential", "bonus", "inside info"
        ]
        text_to_scan = f"{str(subject)} {str(body)}".lower()
        count = sum(1 for word in risk_keywords if word in text_to_scan)
        # Returns a normalized score 0.0 - 1.0
        return min(count * 0.4, 1.0)

    # --- STAGE 4: LLM REASONING (Thread-Safe for Parallel Batching) ---
    def analyze_single_llm_call(self, data_tuple):
        """
        Designed for parallel execution via ThreadPoolExecutor.
        data_tuple: (index, context, subject, body)
        """
        idx, context, subject, body = data_tuple
        
        prompt = f"""
        Act as a Banking Compliance Surveillance Officer. 
        Analyze the following email for malicious intent (Market Manipulation, Quid Pro Quo, etc.).
        
        CONTEXT (Conversation History): {context}
        SUBJECT: {subject}
        EMAIL BODY: {body}

        OUTPUT FORMAT (Return ONLY JSON):
        {{
            "flagged": true,
            "category": "Name of Category",
            "confidence": 0.0 to 1.0,
            "reason": "Brief explanation of intent",
            "evidence_line": "Exact quote from email/subject triggering flag"
        }}
        """

        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0
        }

        try:
            # Using pooled session for speed
            response = self.session.post(self.endpoint, json=payload, timeout=20)
            response.raise_for_status()
            
            raw_content = response.json()['choices'][0]['message']['content'].strip()
            
            # --- ROBUST SANITIZATION ---
            # Remove markdown blocks and extract only the JSON part
            start_idx = raw_content.find("{")
            end_idx = raw_content.rfind("}")
            if start_idx != -1 and end_idx != -1:
                clean_json = raw_content[start_idx : end_idx + 1]
                result = json.loads(clean_json)
                
                # If violation found, calculate priority and attach original index
                if result.get("flagged"):
                    result['priority'] = self.calculate_priority(
                        result.get('category'), 
                        result.get('confidence', 0)
                    )
                    result['original_index'] = idx
                    return result
            return None
            
        except Exception as e:
            # Silently handle errors in batch to prevent the whole thread from crashing
            return {"error": str(e), "original_index": idx}

    def calculate_priority(self, category, confidence):
        """Calculates score: Category Weight * AI Confidence."""
        weight = self.matrix.get(category, 1)
        # Handle cases where confidence might be missing or non-numeric
        try:
            conf = float(confidence)
        except:
            conf = 0.5
        return round(weight * conf, 2)
