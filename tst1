import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class ComplianceEngine:
    def __init__(self):
        # 1. API Configuration
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # 2. Connection Pooling (Critical for speed in 5000+ data processing)
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })
        
        # 3. Compliance Priority Matrix (Weightage)
        self.matrix = {
            "Market Manipulation": 10,
            "Insider Trading": 10,
            "Quid Pro Quo": 9,
            "Front Running": 9,
            "Secrecy": 7,
            "Policy Violation": 3,
            "Compliant": 0
        }

    def _sanitize_json(self, text):
        """Helper to extract JSON from LLM string responses."""
        try:
            start_idx = text.find("{")
            end_idx = text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                return json.loads(text[start_idx : end_idx + 1])
            return None
        except:
            return None

    # --- NEW: AI RAW TEXT PARSER ---
    def extract_subject_body(self, raw_text):
        """
        Uses AI to intelligently split a single block of pasted email 
        text into 'Subject' and 'Body' fields.
        """
        prompt = f"""
        Act as an email parser. Extract the Subject and Body from the text below.
        If no subject is found, summarize the main point in 5 words for the subject.
        
        RAW EMAIL TEXT:
        \"\"\"{raw_text}\"\"\"

        Return ONLY a JSON object:
        {{"subject": "...", "body": "..."}}
        """
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0}
        
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=10)
            res_data = response.json()['choices'][0]['message']['content']
            parsed = self._sanitize_json(res_data)
            return parsed if parsed else {"subject": "Unknown", "body": raw_text}
        except:
            return {"subject": "Unknown", "body": raw_text}

    # --- STAGE 1: PRE-FILTERING (Local) ---
    def pre_filter(self, subject, body):
        """Identifies automated noise locally (No LLM cost)."""
        noise_patterns = [r"unsubscribe", r"automatic reply", r"newsletter", r"out of office", r"noreply@"]
        text_to_scan = f"{str(subject)} {str(body)}".lower()
        return any(re.search(pattern, text_to_scan) for pattern in noise_patterns)

    # --- STAGE 2: ML RISK SCORING (Local) ---
    def ml_risk_scoring(self, subject, body):
        """Preliminary risk check locally."""
        risk_keywords = ["guarantee", "off the record", "delete this", "wire", "allocation", "favorable", "inside info"]
        text_to_scan = f"{str(subject)} {str(body)}".lower()
        count = sum(1 for word in risk_keywords if word in text_to_scan)
        return min(count * 0.4, 1.0)

    # --- STAGE 3: LLM REASONING & EXTRACTION ---
    def analyze_single_llm_call(self, data_tuple):
        """
        Final reasoning layer. Extracts intent, reason, and source line.
        data_tuple: (index, context, subject, body)
        """
        idx, context, subject, body = data_tuple
        
        prompt = f"""
        Act as a Banking Compliance Surveillance Officer. 
        Analyze the intent of this communication.
        
        SUBJECT: {subject}
        BODY: {body}
        CONTEXT: {context}

        Check for: Market Manipulation, Quid Pro Quo, Insider Trading, Front Running, Secrecy.
        
        Return ONLY JSON:
        {{
            "flagged": true/false,
            "category": "...",
            "confidence": 0.0 to 1.0,
            "reason": "Identify the specific malicious intent",
            "evidence_line": "Extract the EXACT line from the email"
        }}
        """

        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=20)
            raw_content = response.json()['choices'][0]['message']['content']
            result = self._sanitize_json(raw_content)
            
            if result and result.get("flagged"):
                # Apply priority weightage
                result['priority'] = self.calculate_priority(result.get('category'), result.get('confidence', 0))
                result['original_index'] = idx
                return result
            return None
        except Exception as e:
            return None

    def calculate_priority(self, category, confidence):
        """Priority = Matrix Weight * AI Confidence."""
        weight = self.matrix.get(category, 1)
        try:
            conf = float(confidence)
        except:
            conf = 0.5
        return round(weight * conf, 2)
