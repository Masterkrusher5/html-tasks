import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Universal Intelligence Engine.
    Communicates via direct HTTP requests to an LLM endpoint (Azure, OpenAI, or Gateway).
    Handles Forensic Documentation, high-speed streaming, and Modern Code synthesis.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            # We don't raise an error here so the UI can load and show a warning instead
            return

        # Connection Pooling for high performance and stability
        self.session = requests.Session()
        # Header setup - Standard for Azure OpenAI and most Enterprise Gateways
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _sanitize_json(self, text: str) -> dict:
        """
        Extracts and parses JSON from the LLM response.
        Handles cases where the LLM wraps JSON in markdown blocks (```json ... ```).
        """
        try:
            # 1. Try to find content inside markdown code blocks
            match = re.search(r'```json\s*(.*?)\s*```', text, re.DOTALL)
            if match:
                return json.loads(match.group(1))
            
            # 2. Try to find the first '{' and last '}'
            start_idx = text.find("{")
            end_idx = text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                return json.loads(text[start_idx : end_idx + 1])
            
            # 3. Last resort: direct parse
            return json.loads(text)
        except Exception:
            return {
                "summary": "Parsing Error",
                "description": "The LLM response was not in a valid JSON format.",
                "functions": [],
                "data_dictionary": [],
                "confidence_score": 0.0,
                "auto_approval_status": False
            }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Phase 1: Forensic Knowledge Extraction.
        Produces a granular technical specification and data dictionary.
        """
        prompt = f"""
        Act as a Principal Systems Architect and Forensic Software Engineer. 
        Perform an exhaustive technical and functional analysis of the following legacy code.

        SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Provide a structured JSON output with the following EXACT keys:
        1. "summary": A professional executive summary of the module.
        2. "description": A comprehensive, verbose deep-dive into the business logic.
        3. "functions": A list of objects for every procedure/paragraph found:
           - "name": Formal name.
           - "purpose": Detailed functional goal.
           - "logic_explanation": Step-by-step internal logic breakdown.
           - "inputs_outputs": Variables/files accessed or modified.
           - "business_rules": Specific financial or logical rules enforced.
        4. "data_dictionary": A list of every variable found:
           - "variable": Legacy name.
           - "type": Inferred data type.
           - "role": Role/Meaning in business context.
        5. "dependencies": External files, DB tables, or libraries referenced.
        6. "complexity_rating": Integer (1-10).
        7. "confidence_score": Float (0.0 to 1.0).
        8. "auto_approval_status": Boolean (True if confidence > 0.85).

        Return ONLY the JSON object.
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a forensic architect. Output strictly valid, technical JSON."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=90)
            response.raise_for_status()
            res_data = response.json()
            content = res_data['choices'][0]['message']['content']
            return self._sanitize_json(content)
        except Exception as e:
            return {
                "summary": "Connection Error",
                "description": f"Failed to reach LLM Endpoint: {str(e)}",
                "functions": [],
                "confidence_score": 0.0
            }

    # --- PHASE 3 & 4: STREAMING ENGINE (CODE & TESTS) ---

    def stream_llm(self, prompt: str):
        """
        Standardized SSE (Server-Sent Events) parser for real-time UI streaming.
        Parses the 'data: ' chunks sent by OpenAI-compatible endpoints.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. Provide ONLY production-ready source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0,
            "stream": True 
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as response:
                response.raise_for_status()
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:] # Remove 'data: ' prefix
                        
                        if content_raw == "[DONE]":
                            break
                        
                        try:
                            chunk_json = json.loads(content_raw)
                            if chunk_json.get('choices'):
                                delta = chunk_json['choices'][0].get('delta', {})
                                if 'content' in delta:
                                    yield delta['content']
                        except (json.JSONDecodeError, KeyError):
                            continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    def get_synthesis_prompt(self, doc_data: dict, target_lang: str) -> str:
        """Builds the synthesis prompt based on the Forensic Spec."""
        constraints = ""
        if "Java" in target_lang:
            constraints = (
                "- Use Vanilla Java 17+ (Standard JDK only).\n"
                "- NO SPRING BOOT: Do not use @Service, @Autowired, etc.\n"
                "- No external frameworks."
            )
        else:
            constraints = f"- Use idiomatic {target_lang} standards and modern libraries."

        return f"""
        TASK: Synthesize a single, modern {target_lang} file from this forensic spec.
        
        SPECIFICATION:
        {json.dumps(doc_data)}
        
        CONSTRAINTS:
        {constraints}
        - Maintain all business rules and formulas exactly.
        - Refactor procedural legacy code into a clean, cohesive class/module.
        - Return ONLY the full code content.
        """

    def get_test_prompt(self, modern_code: str, target_lang: str) -> str:
        """Builds the unit test generation prompt."""
        framework = "JUnit 5" if "Java" in target_lang else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for this code:
        
        {modern_code}
        
        REQUIREMENTS:
        - Include success and edge cases.
        - Return ONLY the test source code.
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Maps forensic results to dashboard risk zones."""
        conf = doc_data.get('confidence_score', 0)
        auto = doc_data.get('auto_approval_status', False)
        
        if auto and conf >= 0.85:
            zone, color = "GREEN (Auto-Approved)", "status-green"
        elif conf >= 0.60:
            zone, color = "AMBER (Review Recommended)", "status-amber"
        else:
            zone, color = "RED (Manual Check Required)", "status-red"
            
        return {
            "zone": zone,
            "color": color,
            "confidence_pct": f"{conf * 100:.0f}%",
            "complexity": doc_data.get('complexity_rating', 'N/A')
        }
