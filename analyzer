import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Intelligence Engine for Azure OpenAI.
    Performs deep-dive technical and functional analysis of legacy source code.
    """
    def __init__(self):
        # Configuration from Azure environment
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection Pooling for high-stability API calls
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def _sanitize_json(self, text: str) -> dict:
        """
        Extracts and parses JSON from the LLM response.
        Handles markdown wrappers (```json ... ```).
        """
        try:
            # 1. Try direct parsing
            return json.loads(text)
        except json.JSONDecodeError:
            try:
                # 2. Strip markdown code blocks and try again
                clean_text = re.sub(r'```json|```', '', text).strip()
                return json.loads(clean_text)
            except Exception:
                # 3. Last resort: Regex search for the first { and last }
                match = re.search(r'\{.*\}', text, re.DOTALL)
                if match:
                    return json.loads(match.group())
                return {
                    "summary": "Parsing Error",
                    "description": "The AI response could not be parsed as structured JSON.",
                    "functions": [],
                    "confidence_score": 0.0
                }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Performs a deep-dive forensic analysis to create a Living Specification.
        Extracts business rules, data dictionaries, and logic flows.
        """
        prompt = f"""
        Act as a Principal Systems Architect and Forensic Software Engineer. 
        Perform an exhaustive technical and functional analysis of the following legacy code.

        SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Provide a structured JSON output with the following EXACT keys:
        1. "summary": A professional executive summary of the code's objective.
        2. "description": A comprehensive, multi-paragraph deep-dive into the end-to-end 
           business logic. Explain the 'WHY' behind the operations, the architectural 
           data flow, and state management.
        3. "functions": A list of every procedure, paragraph, or subroutine containing:
           - "name": Formal identifier.
           - "purpose": Detailed functional goal.
           - "logic_explanation": A granular, step-by-step breakdown of the logic inside.
           - "inputs_outputs": Specific variables or files accessed/modified.
           - "business_rules": Specific financial or logical rules enforced in this block.
        4. "data_dictionary": A list of key variables/fields found:
           - "variable": Legacy name.
           - "type": Inferred data type.
           - "role": Role/Meaning within the business context.
        5. "dependencies": External files (e.g., SELECT/ASSIGN), DB tables, or libraries.
        6. "complexity_rating": Integer (1-10) based on nesting and spaghetti factors.
        7. "confidence_score": Float (0.0 to 1.0) representing analysis certainty.
        8. "auto_approval_status": Boolean (True if logic is clear and confidence > 0.85).

        Ensure 'description' and 'logic_explanation' are extremely verbose and technical.
        Return ONLY the JSON object.
        """
        
        payload = {
            "messages": [
                {
                    "role": "system", 
                    "content": "You are a Forensic Systems Architect. You output strictly valid, detailed JSON."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ],
            "temperature": 0
        }

        try:
            # Azure OpenAI direct call
            response = self.session.post(self.endpoint, json=payload, timeout=90)
            response.raise_for_status()
            
            raw_content = response.json()['choices'][0]['message']['content']
            return self._sanitize_json(raw_content)

        except Exception as e:
            return {
                "summary": "Analysis Connection Error",
                "description": f"Failed to perform forensic analysis: {str(e)}",
                "functions": [],
                "data_dictionary": [],
                "confidence_score": 0.0,
                "auto_approval_status": False
            }

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """
        Maps the forensic analysis data to Dashboard Heatmap zones.
        Determines if the module is Green, Amber, or Red.
        """
        conf = doc_data.get('confidence_score', 0)
        auto = doc_data.get('auto_approval_status', False)
        
        # Quality Gate Logic
        if auto and conf >= 0.85:
            zone, color = "GREEN (Auto-Approved)", "green"
        elif conf >= 0.60:
            zone, color = "AMBER (Review Recommended)", "orange"
        else:
            zone, color = "RED (Manual Check Required)", "red"
            
        return {
            "zone": zone,
            "color": color,
            "confidence_pct": f"{conf * 100:.1f}%",
            "complexity": doc_data.get('complexity_rating', 'N/A')
        }
