import os
import json
import re
import requests
from concurrent.futures import ThreadPoolExecutor
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Parallel Forensic Intelligence Engine.
    Uses multi-threading to extract logic and narrative concurrently,
    preventing 400 Bad Request errors by splitting large payloads.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance and streaming stability
        self.session = requests.Session()
        # Most enterprise gateways use 'api-key'. For standard OpenAI, use 'Authorization': 'Bearer ...'
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 15000) -> str:
        """Prevents context overflow errors."""
        return text[:max_chars] + "\n...[CODE TRUNCATED FOR PROCESSING]..." if len(text) > max_chars else text

    def _extract_json_block(self, text: str) -> any:
        """Surgically extracts JSON from a string, handling markdown wrappers."""
        try:
            match = re.search(r'(\[.*\]|\{.*\})', text, re.DOTALL)
            if match:
                clean_json = match.group(1)
                # Basic fix for common LLM unescaped newline errors
                clean_json = clean_json.replace('\n', '\\n').replace('\r', '\\r')
                # Restore structural newlines for braces
                clean_json = clean_json.replace('}\\n{', '}\n{').replace(']\\n[', ']\n[')
                return json.loads(match.group(1))
            return []
        except:
            return []

    # --- PARALLEL SUB-TASKS ---

    def _call_narrative_task(self, code: str) -> dict:
        """THREAD 1: Focused on long-form technical documentation."""
        prompt = f"""
        Act as a Principal Systems Analyst. Provide two things for the code below:
        1. A Technical SUMMARY (150-200 words). Explain goals and context.
        2. A verbose multi-paragraph DESCRIPTION of the logical execution flow.
        
        NO HTML. USE PLAIN TEXT.
        CODE:
        {code}
        """
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0.1, "max_tokens": 1500}
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            return {"summary": content[:1500], "description": content} # Basic split
        except:
            return {"summary": "Narrative extraction failed.", "description": ""}

    def _call_metadata_task(self, code: str) -> dict:
        """THREAD 2: Focused on structured technical mapping (JSON)."""
        prompt = f"""
        Analyze the legacy code and return ONLY a JSON object.
        Keys: 
        - functions: list of {{name, purpose, logic_explanation, business_rules}}
        - data_dictionary: list of {{variable, role}}
        - dependencies: list of strings
        - metrics: {{complexity: 1-10, confidence: 0-1}}

        CODE:
        {code}
        """
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0}
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            data = self._extract_json_block(content)
            return data if isinstance(data, dict) else {"functions": [], "data_dictionary": []}
        except:
            return {"functions": [], "data_dictionary": []}

    # --- PHASE 2: PARALLEL KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Phase 1: Multi-threaded Forensic Analysis.
        Executes Narrative and Metadata calls in parallel to maximize speed 
        and minimize payload size per request.
        """
        safe_code = self._safe_truncate(code)
        
        # Execute both tasks concurrently
        with ThreadPoolExecutor(max_workers=2) as executor:
            future_n = executor.submit(self._call_narrative_task, safe_code)
            future_m = executor.submit(self._call_metadata_task, safe_code)
            
            narrative = future_n.result()
            metadata = future_m.result()

        # Merge results into a unified forensic spec
        return {
            "summary": narrative.get("summary"),
            "description": narrative.get("description"),
            "functions": metadata.get("functions", []),
            "data_dictionary": metadata.get("data_dictionary", []),
            "dependencies": metadata.get("dependencies", []),
            "complexity_rating": metadata.get("metrics", {}).get("complexity", 7),
            "confidence_score": metadata.get("metrics", {}).get("confidence", 0.8)
        }

    # --- PHASE 3: SURGICAL SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_stack: str) -> str:
        """
        Generates a surgical prompt for complete file synthesis.
        Removes redundant fields to keep the request size below gateway limits.
        """
        # We use a compact spec for the synthesis prompt to avoid 400 errors
        compact_spec = {
            "summary": doc_data.get("summary"),
            "business_logic_units": doc_data.get("functions"),
            "variables": doc_data.get("data_dictionary")
        }
        
        java_rules = ""
        if "Java" in target_stack:
            java_rules = "- Target: Vanilla Java 17+.\n- NO SPRING BOOT/Annotations.\n- Standard JDK libraries only."

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. PROVIDE FULL FILE STRUCTURE.

        LOGIC SPECIFICATION:
        {json.dumps(compact_spec)}

        REQUIREMENTS:
        1. STRUCTURE: Full file with imports, package, and class definition.
        2. ENCAPSULATION: Map legacy 'variables' to private class fields.
        3. LOGIC PARITY: Implement logic for all 'business_logic_units' exactly.
        4. SINGLE FILE: No snippets. Cohesive standalone unit.
        5. {java_rules}

        Return ONLY the source code.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for real-time streaming."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. Output ONLY valid, complete source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk_json = json.loads(content_raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 4: VALIDATION ---

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"Generate a FULL comprehensive {framework} test suite for this code:\n{modern_code}"

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        conf = float(doc_data.get('confidence_score', 0.8))
        color = "green" if conf >= 0.8 else "orange" if conf >= 0.6 else "red"
        return {
            "zone": "GREEN" if conf >= 0.8 else "AMBER" if conf >= 0.6 else "RED (High Risk)",
            "color": color,
            "confidence_pct": f"{conf*100:.0f}%",
            "complexity": doc_data.get('complexity_rating', 5)
        }
