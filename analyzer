import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Universal Intelligence Engine for Forensic Modernization.
    Refactored to produce verbose documentation and high-fidelity, complete source code.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance
        self.session = requests.Session()
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _sanitize_json(self, text: str) -> dict:
        """Robustly extracts JSON from LLM responses, cleaning any markdown wrappers."""
        try:
            # Try to find content inside markdown code blocks first
            match = re.search(r'```json\s*(.*?)\s*```', text, re.DOTALL)
            if match:
                return json.loads(match.group(1))
            
            # Find the first '{' and last '}'
            start_idx = text.find("{")
            end_idx = text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                return json.loads(text[start_idx : end_idx + 1])
            
            return json.loads(text)
        except Exception:
            return {
                "summary": "Forensic Parsing Error",
                "description": "The AI response failed JSON validation. Raw output: " + text[:500],
                "functions": [],
                "data_dictionary": [],
                "confidence_score": 0.0
            }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Extracts exhaustive business logic specs.
        DEMAND: Long, detailed plain-text summary (300+ words).
        """
        prompt = f"""
        Act as a Principal Systems Architect. Perform an exhaustive forensic analysis of the provided legacy code.
        
        SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Provide a structured JSON object with EXACTLY these keys:
        1. "summary": Provide a LONG, multi-paragraph technical summary (at least 300 words). 
           Detail the business domain, system goals, architectural pattern of the legacy code, 
           and how it handles end-to-end processing. DO NOT use any HTML tags.
        2. "description": A verbose deep-dive into the execution flow, state transitions, and I/O.
        3. "functions": A list of every procedure/paragraph containing:
           - "name": Identifier.
           - "purpose": Detailed goal.
           - "logic_explanation": Granular step-by-step breakdown.
           - "business_rules": Specific logic/math rules.
        4. "data_dictionary": A list of every key variable found:
           - "variable": Name.
           - "role": Its business meaning and purpose.
        5. "dependencies": List of external files/DBs.
        6. "complexity_rating": Integer (1-10).
        7. "confidence_score": Float (0.0-1.0).
        8. "auto_approval_status": Boolean.

        Ensure the summary and description are extremely detailed.
        Return ONLY the JSON object.
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a senior forensic systems analyst. You write long, detailed documentation without using HTML."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=90)
            response.raise_for_status()
            res_data = response.json()
            content = res_data['choices'][0]['message']['content']
            return self._sanitize_json(content)
        except Exception as e:
            return {
                "summary": "Connection Error",
                "description": f"Failed to reach the LLM Endpoint: {str(e)}",
                "functions": [],
                "confidence_score": 0.0
            }

    # --- PHASE 3: HIGH-FIDELITY CODE SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_lang: str) -> str:
        """
        Constructs the prompt for a UNIFIED, COMPLETE FILE.
        DEMAND: Runnable class structure, not just functions.
        """
        java_constraints = ""
        if "Java" in target_lang:
            java_constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use @Service, @Component, etc.\n"
                "- STANDARD LIBRARIES ONLY: Use java.util, java.math.BigDecimal, java.time, etc.\n"
            )

        return f"""
        TASK: Synthesize the COMPLETE, RUNNABLE source code for a single {target_lang} file.
        
        SPECIFICATION BLUEPRINT:
        {json.dumps(doc_data)}
        
        CRITICAL ARCHITECTURAL REQUIREMENTS:
        1. COMPLETE FILE STRUCTURE: You MUST provide the full file, including package declarations, all necessary imports, and the public class/module definition.
        2. DO NOT JUST GENERATE FUNCTIONS: The output must be a cohesive, compilable program that can be executed.
        3. GLOBAL STATE: Map all legacy global variables (found in the data dictionary) to PRIVATE CLASS MEMBER VARIABLES to maintain state throughout the lifecycle.
        4. BUSINESS LOGIC: Replicate all mathematical formulas and logical branching identified in the 'Forensic Spec' with 100% accuracy.
        5. CLEAN CODE: Use meaningful names, modularize methods, and implement proper error handling (e.g. Try-Catch).
        6. {java_constraints}
        
        Return ONLY the full source code content. No conversational text.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for streaming code tokens in real-time."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Modernization Architect. Output ONLY valid, complete source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0,
            "stream": True 
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as response:
                response.raise_for_status()
                for line in response.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:]
                        if content_raw == "[DONE]":
                            break
                        try:
                            chunk_json = json.loads(content_raw)
                            delta = chunk_json['choices'][0].get('delta', {})
                            if 'content' in delta:
                                yield delta['content']
                        except:
                            continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 4: COMPREHENSIVE TESTING ---

    def get_test_prompt(self, modern_code: str, target_lang: str) -> str:
        """Demands a full test suite for the synthesized file."""
        framework = "JUnit 5" if "Java" in target_lang else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the modernized code below.
        
        CODE TO TEST:
        {modern_code}
        
        REQUIREMENTS:
        1. Ensure 100% logical coverage.
        2. Include test cases for initialization, main business logic paths, and error/edge cases.
        3. Return ONLY the full test source code content.
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Dashboard logic."""
        conf = doc_data.get('confidence_score', 0)
        auto = doc_data.get('auto_approval_status', False)
        
        if auto and conf >= 0.85:
            zone, color = "GREEN (Auto-Approved)", "green"
        elif conf >= 0.60:
            zone, color = "AMBER (Review Recommended)", "orange"
        else:
            zone, color = "RED (Manual Check Required)", "red"
            
        return {
            "zone": zone,
            "color": color,
            "confidence_pct": f"{conf * 100:.0f}%",
            "complexity": doc_data.get('complexity_rating', 'N/A')
        }
