import os
import json
import re
import requests
from concurrent.futures import ThreadPoolExecutor
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine (High-Fidelity Version).
    Handles parallel logic extraction and high-density code synthesis.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance
        self.session = requests.Session()
        # Standard header setup for Azure/Enterprise Gateways
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 15000) -> str:
        """Ensures input payload doesn't exceed gateway limits."""
        return text[:max_chars] + "\n...[CODE TRUNCATED]..." if len(text) > max_chars else text

    def _extract_json_block(self, text: str) -> any:
        """Surgically extracts JSON from a string, repairing common LLM errors."""
        try:
            # 1. Look for content inside markdown code blocks
            match = re.search(r'(\[.*\]|\{.*\})', text, re.DOTALL)
            if match:
                clean_json = match.group(1)
                # Escape literal newlines within JSON values
                clean_json = clean_json.replace('\n', '\\n').replace('\r', '\\r')
                # Restore structural newlines for braces/brackets
                clean_json = clean_json.replace('}\\n{', '}\n{').replace(']\\n[', ']\n[')
                return json.loads(clean_json)
            return []
        except:
            return []

    # --- PARALLEL FORENSIC TASKS ---

    def _call_narrative_task(self, code: str) -> dict:
        """THREAD A: High-detail technical technical report generation."""
        prompt = f"""
        Act as a Principal Software Architect. Provide an exhaustive Technical Specification for the code below.
        
        REQUIREMENTS (300-400 words total):
        1. BUSINESS GOAL: Explain exactly what this system achieves.
        2. ARCHITECTURE: Describe legacy design patterns, data flow, and processing strategy.
        3. STATE MANAGEMENT: Detail how variables and files maintain system state.
        4. COMPLEXITY ANALYSIS: Identify the most critical and high-risk logic branches.

        CONSTRAINTS: No HTML. Plain Text or Markdown only. Be extremely verbose and technical.
        
        CODE:
        {code}
        """
        payload = {
            "messages": [{"role": "system", "content": "You are a professional architect. You write 400-word deep-dives."}, 
                         {"role": "user", "content": prompt}],
            "temperature": 0.2, 
            "max_tokens": 2000
        }
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            return {"summary": content, "description": content}
        except:
            return {"summary": "Narrative extraction failed.", "description": ""}

    def _call_metadata_task(self, code: str) -> dict:
        """THREAD B: Structural mapping extraction (JSON)."""
        prompt = f"""
        Analyze the legacy code and return ONLY a JSON object.
        Keys: 
        - functions: list of {{name, purpose, logic_explanation, business_rules}}
        - data_dictionary: list of {{variable, role}}
        - dependencies: list of strings
        - metrics: {{complexity: 1-10, confidence: 0-1}}

        CODE:
        {code}
        """
        payload = {
            "messages": [{"role": "system", "content": "You are a compiler analyst. Output ONLY JSON."}, 
                         {"role": "user", "content": prompt}],
            "temperature": 0,
            "max_tokens": 2500
        }
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            data = self._extract_json_block(content)
            return data if isinstance(data, dict) else {"functions": [], "data_dictionary": []}
        except:
            return {"functions": [], "data_dictionary": []}

    # --- PHASE 2: ORCHESTRATION ---

    def generate_documentation(self, code: str) -> dict:
        """Runs Forensic Analysis in parallel threads to prevent 400 errors and speed up processing."""
        safe_code = self._safe_truncate(code)
        
        with ThreadPoolExecutor(max_workers=2) as executor:
            future_n = executor.submit(self._call_narrative_task, safe_code)
            future_m = executor.submit(self._call_metadata_task, safe_code)
            
            narrative = future_n.result()
            metadata = future_m.result()

        return {
            "summary": narrative.get("summary"),
            "description": narrative.get("description"),
            "functions": metadata.get("functions", []),
            "data_dictionary": metadata.get("data_dictionary", []),
            "dependencies": metadata.get("dependencies", []),
            "complexity_rating": metadata.get("metrics", {}).get("complexity", 7),
            "confidence_score": metadata.get("metrics", {}).get("confidence", 0.8)
        }

    # --- PHASE 3: HIGH-DENSITY SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_stack: str) -> str:
        """
        Builds a surgical synthesis prompt. 
        Excludes the long narrative to maximize the output token budget for code.
        """
        # Compact spec focusing on logic nodes and variable mapping
        compact_spec = {
            "business_logic_units": doc_data.get("functions"),
            "state_variables": doc_data.get("data_dictionary")
        }
        
        java_rules = ""
        if "Java" in target_stack:
            java_rules = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use any annotations or frameworks.\n"
                "- Standard JDK libraries only (java.math.BigDecimal for precision).\n"
            )

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. YOU MUST PROVIDE THE FULL FILE STRUCTURE.

        LOGIC SPECIFICATION:
        {json.dumps(compact_spec)}

        STRICT ARCHITECTURAL REQUIREMENTS:
        1. FULL FILE: Include all imports, package headers, and the public class definition.
        2. ENCAPSULATION: Map 'state_variables' to PRIVATE CLASS MEMBER VARIABLES.
        3. LOGIC PARITY: Replicate mathematical formulas and logical branches for all 'business_logic_units'.
        4. LOGIC DENSITY: Skip verbose comments inside methods to prevent output truncation.
        5. SINGLE FILE: No snippets. Cohesive standalone code only.
        6. {java_rules}

        Return ONLY the full source code content.
        """

    def stream_llm(self, prompt: str):
        """SSE Parser optimized for long-duration code synthesis."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Software Architect. Output ONLY valid, complete source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000 # Absolute high limit for full-file completion
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk_json = json.loads(content_raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 4: VALIDATION ---

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Generates comprehensive tests with 100% path coverage."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test suite for the code provided.
        Ensure every business logic path and edge case is covered.
        
        CODE:
        {modern_code}
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Dashboard logic for risk heatmap."""
        conf = float(doc_data.get('confidence_score', 0.8))
        if conf >= 0.85:
            color, zone = "green", "GREEN (Ready)"
        elif conf >= 0.60:
            color, zone = "orange", "AMBER (Review)"
        else:
            color, zone = "red", "RED (High Risk)"
            
        return {
            "zone": zone,
            "color": color,
            "confidence_pct": f"{conf*100:.0f}%",
            "complexity": doc_data.get('complexity_rating', 5)
        }
