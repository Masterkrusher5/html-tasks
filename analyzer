import os
import json
import requests
from dotenv import load_dotenv

load_dotenv()

class UnifiedOpenAIAgent:
    def __init__(self):
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        self.session = requests.Session()
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def generate_summary(self, global_context: str) -> dict:
        if not global_context or len(global_context) < 50:
            return {"summary": "Insufficient data to generate summary."}

        prompt = f"""
        Analyze this Legacy Code Context (Headers/Variables) and provide a 200-word System Summary.
        Identify the business domain and potential logic based on variables found.
        
        CODE CONTEXT:
        {global_context[:12000]}
        
        Return JSON: {{"summary": "Your text here"}}
        """
        
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0.2}
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=60)
            res_json = response.json()
            content = res_json['choices'][0]['message']['content']
            if "```" in content:
                content = content.split("```json")[1].split("```")[0].strip() if "```json" in content else content.replace("```", "").strip()
            return json.loads(content)
        except:
            return {"summary": "Summary analysis failed."}

    def generate_global_structure(self, global_context: str, target_lang: str) -> str:
        prompt = f"""
        TASK: Generate the Class Structure (Header, Imports, Private Member Variables) for {target_lang}.
        Based on this Legacy Global Context:
        
        {global_context[:8000]}
        
        INSTRUCTIONS:
        1. Define the class.
        2. Define private member variables to match the legacy data types.
        3. Do NOT write any methods or logic blocks yet.
        4. Return Code Only. No markdown wrappers.
        """
        
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0.1}
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=60)
            content = response.json()['choices'][0]['message']['content']
            return content.replace("```java", "").replace("```python", "").replace("```", "").strip()
        except:
            return f"// Error generating structure for {target_lang}"

    def process_chunk_stream(self, chunk: dict, global_context: str, target_lang: str):
        java_constraints = "Use Vanilla Java 17+ syntax. No Spring annotations." if "Java" in target_lang else ""

        prompt = f"""
        TASK: Convert this specific Legacy Code Chunk to {target_lang}.
        
        GLOBAL CONTEXT (Class Variables/State available):
        \"\"\"
        {global_context[:6000]} 
        \"\"\"
        
        CURRENT CHUNK TO CONVERT:
        Name: {chunk['name']}
        Code:
        \"\"\"
        {chunk['code']}
        \"\"\"
        
        INSTRUCTIONS:
        1. Output ONLY the code for this specific method/function.
        2. Use the Global Context to correctly reference class member variables.
        3. Do NOT output class headers, imports, or closing braces.
        4. {java_constraints}
        
        START CODE IMMEDIATELY:
        """
        
        payload = {
            "messages": [
                {"role": "system", "content": "You are a code conversion engine. Output code only."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 2000
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as resp:
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            raw = line_text[6:]
                            if raw == "[DONE]": break
                            try:
                                chunk_json = json.loads(raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta: yield delta
                            except: continue
        except Exception as e:
            yield f"// Error converting chunk {chunk['name']}: {str(e)}"

    def get_test_prompt(self, full_code: str, target_lang: str) -> str:
        framework = "JUnit 5" if "Java" in target_lang else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the modernized code below.
        Ensure every business logic path and edge case is covered.
        
        CODE TO TEST:
        {full_code[:15000]}
        """

    def calculate_dashboard_metrics(self, doc_text: str) -> dict:
        length = len(doc_text)
        if length > 500:
            return {"zone": "GREEN", "color": "green", "confidence_pct": "95%", "complexity": 5}
        return {"zone": "AMBER", "color": "orange", "confidence_pct": "70%", "complexity": 8}
