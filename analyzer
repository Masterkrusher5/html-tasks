import os
import json
import re
import requests
from concurrent.futures import ThreadPoolExecutor
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    High-Performance Multi-Threaded Forensic Engine.
    Uses 'Segmented Synthesis' to bypass LLM output token limits and 
    prevent mid-file truncation.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance
        self.session = requests.Session()
        # Most enterprise gateways use 'api-key'. For standard OpenAI, use 'Authorization': 'Bearer ...'
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 12000) -> str:
        """Prevents context overflow (400 Bad Request)."""
        return text[:max_chars] + "\n...[CODE TRUNCATED]..." if len(text) > max_chars else text

    def _extract_json_block(self, text: str) -> any:
        """Surgically extracts JSON from LLM response."""
        try:
            match = re.search(r'(\[.*\]|\{.*\})', text, re.DOTALL)
            if match:
                clean_json = match.group(1).replace('\n', '\\n').replace('\r', '\\r')
                clean_json = clean_json.replace('}\\n{', '}\n{').replace(']\\n[', ']\n[')
                return json.loads(clean_json)
            return []
        except:
            return []

    # --- PHASE 1: PARALLEL FORENSIC ANALYSIS ---

    def _call_narrative_task(self, code: str) -> dict:
        """THREAD 1: Focused on technical summary and deep-dive."""
        prompt = f"""
        Act as a Principal Systems Architect. Provide an exhaustive Technical Specification for the code below.
        
        REQUIREMENTS (300-400 words total):
        1. BUSINESS GOAL: Explain exactly what this system achieves.
        2. ARCHITECTURE: Describe legacy design patterns, data flow, and processing strategy.
        3. STATE MANAGEMENT: Detail how variables and files maintain system state.
        
        NO HTML. USE PLAIN TEXT.
        CODE:
        {code}
        """
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0.2, "max_tokens": 1500}
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            return {"summary": content, "description": content}
        except:
            return {"summary": "Narrative extraction failed.", "description": ""}

    def _call_metadata_task(self, code: str) -> dict:
        """THREAD 2: Focused on structured technical mapping (JSON)."""
        prompt = f"""
        Analyze the legacy code and return ONLY a JSON object.
        Keys: 
        - functions: list of {{name, purpose, logic_explanation, business_rules}}
        - data_dictionary: list of {{variable, role}}
        - dependencies: list of strings
        - metrics: {{complexity: 1-10, confidence: 0-1}}

        CODE:
        {code}
        """
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0, "max_tokens": 2000}
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=90).json()
            content = res['choices'][0]['message']['content']
            data = self._extract_json_block(content)
            return data if isinstance(data, dict) else {"functions": [], "data_dictionary": []}
        except:
            return {"functions": [], "data_dictionary": []}

    def generate_documentation(self, code: str) -> dict:
        """Orchestrates parallel analysis."""
        safe_code = self._safe_truncate(code)
        with ThreadPoolExecutor(max_workers=2) as executor:
            f_n = executor.submit(self._call_narrative_task, safe_code)
            f_m = executor.submit(self._call_metadata_task, safe_code)
            narrative, metadata = f_n.result(), f_m.result()

        return {
            "summary": narrative.get("summary"),
            "description": narrative.get("description"),
            "functions": metadata.get("functions", []),
            "data_dictionary": metadata.get("data_dictionary", []),
            "dependencies": metadata.get("dependencies", []),
            "complexity_rating": metadata.get("metrics", {}).get("complexity", 7),
            "confidence_score": metadata.get("metrics", {}).get("confidence", 0.8)
        }

    # --- PHASE 2: SEGMENTED PARALLEL SYNTHESIS ---

    def get_skeleton_prompt(self, doc_data: dict, target_stack: str) -> str:
        """Builds the file header, imports, and member variables."""
        vars_json = json.dumps(doc_data.get('data_dictionary', []))
        return f"""
        TASK: GENERATE ONLY THE SKELETON FOR A COMPLETE {target_stack} FILE.
        
        INSTRUCTIONS:
        1. Include: Package, all necessary Imports, Class Definition.
        2. ENCAPSULATION: Define PRIVATE MEMBER VARIABLES for every item in this dictionary: {vars_json}.
        3. DO NOT include method logic or bodies.
        4. STOP immediately after the variable declarations.
        5. NO SNIPPETS. Provide the full top-level file structure.
        """

    def get_methods_prompt(self, doc_data: dict, target_stack: str) -> str:
        """Builds the actual logic of the methods."""
        funcs_json = json.dumps(doc_data.get('functions', []))
        return f"""
        TASK: GENERATE THE IMPLEMENTATION FOR ALL METHODS IN A {target_stack} CLASS.
        
        LOGIC TO IMPLEMENT:
        {funcs_json}
        
        INSTRUCTIONS:
        1. Write the full method bodies based on the functional specs.
        2. Ensure logic parity with the business rules.
        3. DO NOT include imports or class headers.
        4. Focus on the internal logic flow.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Streaming Parser."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. Output ONLY source code."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000
        }
        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            raw = line_text[6:]
                            if raw == "[DONE]": break
                            try:
                                delta = json.loads(raw)['choices'][0].get('delta', {}).get('content', '')
                                if delta: yield delta
                            except: continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 4: VALIDATION ---

    def get_test_prompt(self, full_code: str, target_stack: str) -> str:
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"Generate a FULL {framework} test suite for the code below. Ensure 100% path coverage:\n{full_code}"

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        conf = float(doc_data.get('confidence_score', 0.8))
        return {
            "zone": "GREEN" if conf >= 0.85 else "AMBER" if conf >= 0.60 else "RED",
            "color": "green" if conf >= 0.85 else "orange" if conf >= 0.60 else "red",
            "confidence_pct": f"{conf*100:.0f}%",
            "complexity": doc_data.get('complexity_rating', 5)
        }
