from langchain_openai import AzureChatOpenAI
from langchain_core.output_parsers import JsonOutputParser
from langchain.prompts import ChatPromptTemplate
import os

class StaticSemanticAnalyzer:
    def __init__(self):
        self.llm = AzureChatOpenAI(
            azure_deployment=os.getenv("AZURE_OPENAI_DEPLOYMENT_NAME"),
            api_key=os.getenv("AZURE_OPENAI_API_KEY"),
            azure_endpoint=os.getenv("AZURE_OPENAI_ENDPOINT"),
            openai_api_version=os.getenv("AZURE_OPENAI_API_VERSION"),
            temperature=0
        )

    def generate_graphs(self, code: str, lang: str):
        """Simulates AST, CFG, and DFG generation using LLM-assisted parsing."""
        prompt = ChatPromptTemplate.from_messages([
            ("system", f"You are a compiler specialist for {lang}."),
            ("user", "Analyze the code and return a JSON structure for: "
                     "1. AST (Tree structure), 2. CFG (Control Flow), 3. DFG (Data Flow).\nCode: {code}")
        ])
        chain = prompt | self.llm | JsonOutputParser()
        return chain.invoke({"code": code})
