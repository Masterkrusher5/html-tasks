import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine.
    Path A: Technical Documentation (Narrative + Metadata).
    Path B: Unified Code Synthesis (Direct from Source).
    """
    def __init__(self):
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        self.session = requests.Session()
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 15000) -> str:
        """Prevents context window overflow."""
        return text[:max_chars] if len(text) <= max_chars else text[:max_chars] + "\n...[TRUNCATED]..."

    # --- PIPELINE A: DOCUMENTATION PROMPT ---
    def get_documentation_prompt(self, code: str) -> str:
        """Constructs prompt for the Analyst thread (100-150 word summary)."""
        return f"""
        Act as a Principal Systems Architect. Analyze the code provided and produce:
        1. TECHNICAL SUMMARY: A concise technical narrative (100-150 words). 
           Focus on system architecture, business domain, and core processing logic.
        2. LOGIC FLOW: Multi-paragraph deep-dive into state management and execution.
        3. METADATA: JSON block for functions, variables, and dependencies.

        CODE:
        {code}
        """

    # --- PIPELINE B: CODE SYNTHESIS PROMPT ---
    def get_synthesis_prompt(self, code: str, target_stack: str) -> str:
        """Constructs prompt for the Coder thread (Complete File focus)."""
        java_rules = ""
        if "Java" in target_stack:
            java_rules = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: No annotations like @Service, @Autowired.\n"
                "- Use standard JDK libraries (java.util, java.math.BigDecimal, etc.).\n"
            )

        return f"""
        TASK: YOU MUST CONVERT THE FOLLOWING LEGACY CODE INTO A SINGLE COMPLETE, RUNNABLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. DO NOT GENERATE SNIPPETS. PROVIDE THE FULL CODE.

        REQUIREMENTS:
        1. FULL FILE STRUCTURE: Include package, all imports, class definition, and methods.
        2. ENCAPSULATION: Map legacy variables to private class fields to maintain state.
        3. LOGIC PARITY: Replicate all math and branching logic with 100% fidelity.
        4. {java_rules}

        LEGACY SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Return ONLY the full source code. Start immediately with imports/package.
        """

    # --- PIPELINE C: UNIT TEST PROMPT ---
    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Constructs prompt for the QA thread."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        TASK: Generate the COMPLETE {framework} unit test class for the code below.
        
        CODE TO TEST:
        {modern_code}
        
        REQUIREMENTS:
        1. 100% Coverage: Include success paths and edge cases.
        2. Mocking: Use standard mocking for external dependencies if any.
        3. Return ONLY the full test source code.
        """

    def stream_llm(self, prompt: str, max_tokens: int = 4096):
        """
        Standardized SSE Streaming Parser. 
        max_tokens is set high to ensure full code completion.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a specialized modernization architect. You provide exhaustive, complete outputs."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": max_tokens
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=300) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk = json.loads(content_raw)
                                delta = chunk['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    def calculate_dashboard_metrics(self, doc_text: str) -> dict:
        """Heuristic risk metrics based on documentation length and keywords."""
        length = len(doc_text)
        if length > 1000:
            return {"zone": "GREEN", "color": "green", "confidence": "95%"}
        return {"zone": "AMBER", "color": "orange", "confidence": "70%"}
