import os
import json
import requests
from dotenv import load_dotenv

load_dotenv()

class UnifiedOpenAIAgent:
    def __init__(self):
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        self.session = requests.Session()
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def process_chunk_stream(self, chunk: dict, global_context: str, target_lang: str):
        java_constraints = "Vanilla Java 17+, No Spring." if "Java" in target_lang else ""
        
        prompt = f"""
        TASK: Convert this specific Legacy Code Chunk to {target_lang}.
        
        GLOBAL CONTEXT (Variables/State):
        \"\"\"
        {global_context[:5000]} 
        \"\"\"
        
        CURRENT CHUNK TO CONVERT:
        Name: {chunk['name']}
        Code:
        \"\"\"
        {chunk['code']}
        \"\"\"
        
        INSTRUCTIONS:
        1. Output ONLY the code for this method/function.
        2. Use the Global Context to correctly reference class variables.
        3. Do not output class headers or imports.
        4. {java_constraints}
        """
        
        payload = {
            "messages": [{"role": "system", "content": "You are a code conversion engine. Output code only."},
                         {"role": "user", "content": prompt}],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 2000
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=120) as resp:
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            raw = line_text[6:]
                            if raw == "[DONE]": break
                            try:
                                delta = json.loads(raw)['choices'][0].get('delta', {}).get('content', '')
                                if delta: yield delta
                            except: continue
        except Exception as e:
            yield f"// Error converting chunk {chunk['name']}: {str(e)}"

    def generate_global_structure(self, global_context: str, target_lang: str) -> str:
        prompt = f"""
        TASK: Generate the Class Structure (Header, Imports, Private Member Variables) for {target_lang}.
        Based on this Legacy Global Context:
        
        {global_context[:8000]}
        
        INSTRUCTIONS:
        1. Define the class.
        2. Define private member variables to match the legacy data.
        3. Do NOT write any methods. Stop before the methods begin.
        4. Return Code Only.
        """
        
        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.1
        }
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=60).json()
            return res['choices'][0]['message']['content']
        except:
            return f"// Error generating structure for {target_lang}"

    def generate_summary(self, global_context: str) -> dict:
        prompt = f"Analyze this Legacy Data Structures/Global Context and provide a 200-word System Summary.\n\n{global_context[:10000]}"
        payload = {"messages": [{"role": "user", "content": prompt}], "temperature": 0.2}
        try:
            res = self.session.post(self.endpoint, json=payload, timeout=60).json()
            return {"summary": res['choices'][0]['message']['content']}
        except: return {"summary": "Analysis failed."}
