import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine.
    Communicates via direct HTTP requests to any LLM endpoint.
    Optimized for high-volume logic extraction and JSON resilience.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance and stability
        self.session = requests.Session()
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 20000) -> str:
        """
        Prevents 400 Bad Request errors by ensuring the input code 
        fits within the LLM's context window with room for the response.
        """
        if len(text) > max_chars:
            return text[:max_chars] + "\n\n... [TRUNCATED FOR CONTEXT LIMITS] ..."
        return text

    def _sanitize_json(self, text: str) -> dict:
        """
        Aggressive JSON Repair Engine.
        Handles cut-off responses, markdown blocks, and unescaped newlines in long summaries.
        """
        try:
            # 1. Strip Markdown code blocks
            clean_text = re.sub(r'```json\s*|\s*```', '', text, flags=re.DOTALL).strip()
            
            # 2. Extract strictly between first { and last }
            start_idx = clean_text.find("{")
            end_idx = clean_text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                clean_text = clean_text[start_idx : end_idx + 1]

            # 3. Fix common LLM string errors (unescaped newlines within JSON values)
            # This is crucial for the 300+ word summaries
            def replace_newlines(match):
                return match.group(0).replace('\n', '\\n').replace('\r', '\\r')
            
            clean_text = re.sub(r'":\s*"[^"]*"', replace_newlines, clean_text)

            # 4. Direct Parse Attempt
            return json.loads(clean_text)
            
        except json.JSONDecodeError:
            # 5. EMERGENCY REPAIR: Attempt to close dangling JSON if truncated by token limit
            try:
                fixed = clean_text.rstrip().rstrip(',')
                open_braces = fixed.count('{') - fixed.count('}')
                open_brackets = fixed.count('[') - fixed.count(']')
                fixed += (']' * open_brackets) + ('}' * open_braces)
                return json.loads(fixed)
            except Exception:
                # 6. Final Fallback: Return raw text wrapped in a summary key so UI doesn't crash
                return {
                    "summary": "CRITICAL: The AI response was too large to parse as JSON. Raw response is available in logic deep-dive.",
                    "description": text,
                    "functions": [],
                    "data_dictionary": [],
                    "confidence_score": 0.5
                }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Phase 1: Knowledge Extraction.
        Demands a LONG narrative (400+ words) and granular logic mapping.
        """
        # Truncate input to leave ~4k tokens for output summary
        safe_code = self._safe_truncate(code)

        prompt = f"""
        Act as a Principal Systems Architect. Perform an EXHAUSTIVE forensic analysis of the provided code.
        Your output must be a single, valid JSON object. 

        REQUIRED JSON KEYS:
        1. "summary": Provide a LONG (minimum 400 words), multi-paragraph technical narrative of the system. 
           Detail the business domain, system goals, architecture, and overall processing strategy. 
           DO NOT use HTML tags. Use plain text or Markdown only.
        2. "description": A verbose technical deep-dive into logic, state transitions, and file I/O.
        3. "functions": A list of every procedure/paragraph/subroutine found:
           - "name": identifier.
           - "purpose": Detailed functional goal.
           - "logic_explanation": Step-by-step logic breakdown.
           - "business_rules": Specific logical/financial rules enforced.
        4. "data_dictionary": A list of every significant variable found:
           - "variable": name.
           - "role": Its business meaning and purpose.
        5. "dependencies": List of external systems, databases, or libraries.
        6. "complexity_rating": Integer (1-10).
        7. "confidence_score": Float (0.0 to 1.0).

        SOURCE CODE:
        \"\"\"
        {safe_code}
        \"\"\"
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a professional technical analyst. You output ONLY strictly valid JSON. You write extremely long, technical, plain-text documentation."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "max_tokens": 4000 # Critical: Ensure LLM has space to write the long summary
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=180)
            
            if response.status_code != 200:
                return {
                    "summary": f"Connection Error: {response.status_code}",
                    "description": f"The LLM Gateway rejected the request. Details: {response.text}"
                }
            
            res_data = response.json()
            content = res_data['choices'][0]['message']['content']
            return self._sanitize_json(content)
            
        except Exception as e:
            return {
                "summary": "System Failure",
                "description": f"An unexpected error occurred during API communication: {str(e)}"
            }

    # --- PHASE 3: UNSTOPPABLE FULL-FILE SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_lang: str) -> str:
        """
        Phase 2: Modernization.
        Forces the synthesis of a COMPLETE, COMPILABLE file.
        """
        java_constraints = ""
        if "Java" in target_lang:
            java_constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: No @Service, @Autowired, or annotations.\n"
                "- STANDARD JDK ONLY: Use java.util, java.math.BigDecimal, java.time, etc.\n"
            )

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_lang} FILE.
        FAILURE IS NOT AN OPTION. DO NOT GENERATE SNIPPETS. 

        INPUT SPECIFICATION:
        {json.dumps(doc_data)}

        STRICT ARCHITECTURAL REQUIREMENTS:
        1. COMPLETE FILE STRUCTURE: Include package declarations, all necessary imports, and the public class definition.
        2. ENCAPSULATION & STATE: Map all legacy global variables to PRIVATE CLASS MEMBER VARIABLES.
        3. 100% LOGIC PARITY: Implement every mathematical formula and conditional branch from the spec exactly.
        4. SINGLE FILE: The output must be a cohesive, standalone unit.
        5. {java_constraints}

        Return ONLY the full source code content. No conversational text.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for real-time streaming."""
        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000
        }
        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=300) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                delta = json.loads(content_raw)['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    def get_test_prompt(self, modern_code: str, target_lang: str) -> str:
        """Phase 3: Testing."""
        framework = "JUnit 5" if "Java" in target_lang else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the modernized code below.
        Ensure 100% path coverage for the business rules.
        
        CODE:
        {modern_code}
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Maps forensic results to dashboard zones."""
        conf = doc_data.get('confidence_score', 0.5)
        if conf >= 0.85:
            return {"zone": "GREEN", "color": "green", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 5)}
        elif conf >= 0.60:
            return {"zone": "AMBER", "color": "orange", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 7)}
        else:
            return {"zone": "RED (High Risk)", "color": "red", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 9)}
