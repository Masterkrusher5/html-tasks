import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine.
    Optimized for high-fidelity documentation extraction and 
    full-file code synthesis using direct HTTP requests.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance and stability
        self.session = requests.Session()
        # Header setup - using 'api-key' for Azure/Enterprise Gateways
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _sanitize_json(self, text: str) -> dict:
        """
        Aggressive JSON Repair Engine.
        Fixes unescaped newlines in long summaries and repairs cut-off JSON.
        """
        try:
            # 1. Clean markdown noise
            clean_text = re.sub(r'```json\s*|\s*```', '', text, flags=re.DOTALL).strip()
            
            # 2. Extract content between first { and last }
            start_idx = clean_text.find("{")
            end_idx = clean_text.rfind("}")
            if start_idx != -1 and end_idx != -1:
                clean_text = clean_text[start_idx : end_idx + 1]

            # 3. Handle common LLM formatting error: literal newlines inside JSON strings
            # We look for newlines that are not preceded by a comma or brace
            clean_text = re.sub(r'(?<![,\{\}\[\]])\n(?![,\{\}\[\]])', '\\\\n', clean_text)

            # 4. Direct Parse Attempt
            return json.loads(clean_text)
            
        except json.JSONDecodeError:
            # 5. EMERGENCY REPAIR: Attempt to close dangling JSON if truncated
            try:
                fixed = clean_text.rstrip().rstrip(',')
                open_braces = fixed.count('{') - fixed.count('}')
                open_brackets = fixed.count('[') - fixed.count(']')
                fixed += (']' * open_brackets) + ('}' * open_braces)
                return json.loads(fixed)
            except Exception:
                # 6. Fallback: Wrap what we have into a valid structure
                return {
                    "summary": "RECOVERY MODE: JSON Parse failed. Check the Logic deep-dive for raw data.",
                    "description": text[:2000],
                    "functions": [{"name": "Error", "purpose": "Parse Failure"}],
                    "data_dictionary": [{"variable": "Error", "role": "Check raw response"}],
                    "dependencies": ["Error"],
                    "confidence_score": 0.3
                }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Extracts granular technical specs.
        Balanced to ensure all JSON fields (Functions/Vars) are populated.
        """
        # Truncate input code slightly to ensure the prompt + code fits context window
        safe_code = code[:15000] 

        prompt = f"""
        Act as a Principal Systems Architect. Perform a forensic analysis of the following code.
        Your goal is to provide a complete specification in JSON format.

        INSTRUCTIONS FOR JSON FIELDS:
        1. "summary": Write a detailed technical narrative of exactly 150-200 words. 
           Detail the system's purpose and architecture. NO HTML.
        2. "description": Provide a multi-paragraph technical deep-dive into logic and flow.
        3. "functions": Provide a list of objects for EVERY procedure/paragraph found. 
           Include: name, purpose, logic_explanation, business_rules. DO NOT LEAVE BLANK.
        4. "data_dictionary": Provide a list of key variables found. 
           Include: variable, role (its business meaning). DO NOT LEAVE BLANK.
        5. "dependencies": List all external files, databases, or libraries referenced.
        6. "complexity_rating": Integer (1-10).
        7. "confidence_score": Float (0.0 to 1.0).

        SOURCE CODE:
        \"\"\"
        {safe_code}
        \"\"\"
        
        MANDATORY: Return ONLY valid JSON.
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a technical analyst who always outputs strictly valid JSON. You never use HTML tags."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "max_tokens": 3500 # Allocation to ensure summary + tables fit in one response
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=150)
            if response.status_code != 200:
                return {"summary": f"Connection Error: {response.status_code}", "description": response.text}
            
            content = response.json()['choices'][0]['message']['content']
            return self._sanitize_json(content)
        except Exception as e:
            return {"summary": f"System Error: {str(e)}", "description": "Failed to communicate with LLM."}

    # --- PHASE 3: UNSTOPPABLE FULL-FILE SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_stack: str) -> str:
        """
        Builds the prompt for a COMPLETE, RUNNABLE file.
        Strictly forbids snippets.
        """
        java_specifics = ""
        if "Java" in target_stack:
            java_specifics = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use any Spring annotations or frameworks.\n"
                "- STRUCTURE: One public class. Use java.math.BigDecimal for financial precision.\n"
            )

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. YOU MUST PROVIDE THE FULL FILE CONTENT.

        SPECIFICATION BLUEPRINT:
        {json.dumps(doc_data)}

        STRICT ARCHITECTURAL REQUIREMENTS:
        1. FULL FILE STRUCTURE: Include package declarations, all necessary imports, and the public class definition.
        2. ENCAPSULATION: Map legacy global variables to PRIVATE CLASS MEMBER VARIABLES to maintain state.
        3. ACCURACY: Replicate every mathematical formula and logical IF/ELSE branch exactly as described.
        4. NO SNIPPETS: Do not skip boilerplate. The code must be ready to compile and run.
        5. {java_specifics}

        Return ONLY the source code. No conversational text.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for real-time code streaming."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. You produce complete, accurate source code files."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk_json = json.loads(content_raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Demands a full test suite for the synthesized file."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the code below.
        Ensure every business rule is tested. 
        
        CODE:
        {modern_code}
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Dashboard Heatmap logic."""
        conf = doc_data.get('confidence_score', 0.5)
        if conf >= 0.85:
            return {"zone": "GREEN", "color": "green", "confidence_pct": f"{conf*100:.1f}%", "complexity": doc_data.get('complexity_rating', 5)}
        elif conf >= 0.60:
            return {"zone": "AMBER", "color": "orange", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 7)}
        else:
            return {"zone": "RED (Manual Check Required)", "color": "red", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 9)}
