import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine (High Resiliency Version).
    Uses Tagged Content Extraction to handle long technical narratives 
    alongside structured metadata without JSON parsing errors.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance
        self.session = requests.Session()
        # Using 'api-key' header for Azure/Enterprise Gateways
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _extract_tag_content(self, text: str, tag_name: str) -> str:
        """Greedy Regex to extract content between custom XML-style tags."""
        pattern = f"<{tag_name}>(.*?)</{tag_name}>"
        match = re.search(pattern, text, re.DOTALL)
        return match.group(1).strip() if match else ""

    def _parse_resilient_response(self, text: str) -> dict:
        """
        Processes the Tagged response. Narrative parts are extracted as strings,
        Metadata parts are extracted and parsed as independent JSON blocks.
        """
        # 1. Extract Narrative Sections
        summary = self._extract_tag_content(text, "SUMMARY")
        description = self._extract_tag_content(text, "DESCRIPTION")
        
        # 2. Extract JSON Blocks
        funcs_json = self._extract_tag_content(text, "FUNCTIONS_JSON")
        vars_json = self._extract_tag_content(text, "VARS_JSON")
        deps_json = self._extract_tag_content(text, "DEPS_JSON")
        metrics_json = self._extract_tag_content(text, "METRICS_JSON")

        # Fallback initialization
        functions = []
        data_dictionary = []
        dependencies = []
        metrics = {"complexity": 7, "confidence": 0.8}

        # 3. Safely parse internal JSON components
        try:
            if funcs_json: functions = json.loads(funcs_json)
        except: pass
        
        try:
            if vars_json: data_dictionary = json.loads(vars_json)
        except: pass
        
        try:
            if deps_json: dependencies = json.loads(deps_json)
        except: pass

        try:
            if metrics_json: metrics = json.loads(metrics_json)
        except: pass

        return {
            "summary": summary if summary else "Narrative extraction failed. See logic deep-dive.",
            "description": description if description else text,
            "functions": functions,
            "data_dictionary": data_dictionary,
            "dependencies": dependencies,
            "complexity_rating": metrics.get("complexity", 7),
            "confidence_score": metrics.get("confidence", 0.8),
            "auto_approval_status": metrics.get("confidence", 0) >= 0.85
        }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Step 1: Deep-Dive Logic Extraction.
        Demands 150-200 words of technical narrative in a Tagged format.
        """
        # Truncate input code slightly to ensure token safety
        safe_code = code[:18000] 

        prompt = f"""
        Act as a Principal Systems Architect. Analyze the provided legacy code.
        You must produce a forensic report using exactly the TAGGED format below.

        SOURCE CODE:
        \"\"\"
        {safe_code}
        \"\"\"

        MANDATORY OUTPUT FORMAT:
        <SUMMARY>
        Provide a technical narrative of 150-200 words. Detail business context and architecture.
        </SUMMARY>

        <DESCRIPTION>
        A verbose multi-paragraph deep-dive into logic flow, state management, and side effects.
        </DESCRIPTION>

        <FUNCTIONS_JSON>
        [ {{"name": "ProcedureName", "purpose": "goal", "logic_explanation": "step-by-step", "business_rules": "rules"}} ]
        </FUNCTIONS_JSON>

        <VARS_JSON>
        [ {{"variable": "LegacyName", "role": "Business Meaning"}} ]
        </VARS_JSON>

        <DEPS_JSON>
        ["ExternalFile", "DatabaseTable", "Library"]
        </DEPS_JSON>

        <METRICS_JSON>
        {{"complexity": 1-10, "confidence": 0.0-1.0}}
        </METRICS_JSON>
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a forensic technical writer. You separate sections with specific tags <TAG>...</TAG>."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "max_tokens": 4000 
        }

        try:
            response = self.session.post(self.endpoint, json=payload, timeout=180)
            response.raise_for_status()
            content = response.json()['choices'][0]['message']['content']
            return self._parse_resilient_response(content)
        except Exception as e:
            return {
                "summary": f"Connection Error: {str(e)}",
                "description": "The LLM request failed. Ensure your Endpoint and Key are correct."
            }

    # --- PHASE 3: UNSTOPPABLE FULL-FILE SYNTHESIS ---

    def get_synthesis_prompt(self, doc_data: dict, target_stack: str) -> str:
        """
        Step 2: Unified File Synthesis.
        Ensures a single cohesive, runnable file is generated.
        """
        java_rules = ""
        if "Java" in target_stack:
            java_rules = (
                "- Target: Vanilla Java 17+ (No frameworks).\n"
                "- NO SPRING BOOT annotations.\n"
                "- Map logic to a single public class."
            )

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. YOU MUST PROVIDE THE FULL FILE CONTENT.

        INPUT SPECIFICATION:
        Narrative: {doc_data.get('summary')}
        Detailed Logic: {doc_data.get('description')}
        Functional Blueprint: {json.dumps(doc_data.get('functions'))}
        Variable State: {json.dumps(doc_data.get('data_dictionary'))}

        REQUIREMENTS:
        1. COMPLETE FILE STRUCTURE: Include imports, package (if applicable), and class definition.
        2. ENCAPSULATION: Map legacy globals to private member variables.
        3. 100% LOGIC PARITY: Replicate all math and conditional branches exactly.
        4. SINGLE FILE: Cohesive standalone output only. No snippets.
        5. {java_rules}

        Return ONLY source code. No conversational text.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for real-time code streaming."""
        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": 4000
        }
        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=300) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                delta = json.loads(content_raw)['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except:
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Step 3: Generate matching Unit Tests."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"Generate a FULL {framework} test suite for this code. Ensure 100% path coverage:\n{modern_code}"

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Risk analysis for dashboard display."""
        conf = float(doc_data.get('confidence_score', 0.5))
        if conf >= 0.85:
            return {"zone": "GREEN", "color": "green", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 5)}
        elif conf >= 0.60:
            return {"zone": "AMBER", "color": "orange", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 7)}
        else:
            return {"zone": "RED (Manual Check Required)", "color": "red", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 9)}
