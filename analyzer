import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Dual-Pipeline Intelligence Engine.
    Path A: Forensic Documentation & Logic Mapping.
    Path B: Direct Source-to-Target Unified Synthesis.
    
    This architecture prevents mid-file truncation by allocating independent 
    token windows to documentation and code generation.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high-speed parallel streaming
        self.session = requests.Session()
        # Using 'api-key' header (standard for Azure/Enterprise Proxies)
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 15000) -> str:
        """Ensures large legacy files fit in the context window while leaving room for output."""
        return text[:max_chars] if len(text) <= max_chars else text[:max_chars] + "\n...[TRUNCATED FOR CONTEXT]..."

    # --- PIPELINE A: DOCUMENTATION PROMPT ---

    def get_documentation_prompt(self, code: str) -> str:
        """
        Instructions for the Analyst Thread. 
        Demands a deep-dive technical specification.
        """
        return f"""
        Act as a Principal Systems Architect. Perform an EXHAUSTIVE forensic analysis of the legacy code provided.
        
        REQUIRED OUTPUT STRUCTURE:
        1. TECHNICAL SUMMARY: Provide a 300-400 word technical narrative. Detail system goals, business domain, architecture, and overall data strategy. No HTML.
        2. LOGIC DEEP-DIVE: Multi-paragraph explanation of the internal execution flow and state transitions.
        3. METADATA: List all detected procedures/functions and a mapping of key variables to their business roles.

        CODE TO ANALYZE:
        \"\"\"
        {code}
        \"\"\"
        """

    # --- PIPELINE B: UNIFIED SYNTHESIS PROMPT ---

    def get_synthesis_prompt(self, code: str, target_stack: str) -> str:
        """
        Instructions for the Coder Thread.
        Directly transforms source to target without intermediate documentation overhead.
        """
        java_constraints = ""
        if "Java" in target_stack:
            java_constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use any annotations like @Service or @Autowired.\n"
                "- STANDARD JDK ONLY: Use java.util, java.math, java.time, etc.\n"
            )

        return f"""
        TASK: YOU MUST CONVERT THE FOLLOWING LEGACY CODE INTO A SINGLE COMPLETE, RUNNABLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. DO NOT GENERATE SNIPPETS OR PARTIAL FUNCTIONS.

        ARCHITECTURAL REQUIREMENTS:
        1. FULL FILE STRUCTURE: Include all package declarations, all necessary imports, and the public class definition.
        2. ENCAPSULATION: Map global legacy state and variables to PRIVATE CLASS MEMBER VARIABLES.
        3. 100% LOGIC PARITY: Replicate every mathematical formula, conditional 'IF' branch, and side effect with total accuracy.
        4. SINGLE FILE: The output must be a cohesive, compilable standalone program.
        5. {java_constraints}

        LEGACY SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Return ONLY the source code. Start with the code immediately. No conversational text.
        """

    # --- STREAMING ENGINE (SSE Parser) ---

    def stream_llm(self, prompt: str, max_tokens: int = 4000):
        """
        High-performance SSE parser for real-time parallel streaming.
        Handles the standard 'data: ' stream format from Azure/OpenAI gateways.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a professional modernization engine. You output requested content with 100% accuracy and high technical depth."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": max_tokens
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:] # Strip 'data: '
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk_json = json.loads(content_raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except (json.JSONDecodeError, KeyError, IndexError):
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 4: VALIDATION ---

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Generates unit tests based on the final generated code."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the modernized code provided below.
        Ensure 100% logic path coverage.
        
        CODE TO TEST:
        {modern_code}
        """

    def calculate_dashboard_metrics(self, doc_text: str) -> dict:
        """
        Heuristic risk analysis based on the generated documentation.
        Used to populate the 'Risk Zone' metrics on the app dashboard.
        """
        # Simple heuristic: If doc is detailed and long, confidence is high
        length = len(doc_text)
        if length > 1500:
            return {"zone": "GREEN (Ready)", "color": "green", "confidence_pct": "95%", "complexity": "Medium"}
        elif length > 800:
            return {"zone": "AMBER (Review)", "color": "orange", "confidence_pct": "75%", "complexity": "High"}
        else:
            return {"zone": "RED (Risk)", "color": "red", "confidence_pct": "40%", "complexity": "Critical"}
