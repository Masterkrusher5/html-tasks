import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Universal Intelligence Engine.
    Features: SSE Streaming, JSON Repair Logic, and Full-File Synthesis.
    Works with any OpenAI-compatible custom endpoint.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance and streaming stability
        self.session = requests.Session()
        # Most enterprise gateways use 'api-key'. For standard OpenAI, use 'Authorization': 'Bearer ...'
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _sanitize_json(self, text: str) -> dict:
        """
        Aggressive JSON Repair Engine. 
        Handles cut-off text, missing closing braces, and markdown noise.
        """
        clean_text = text.strip()
        
        # 1. Strip Markdown code blocks if the LLM wrapped the JSON
        if "```json" in clean_text:
            clean_text = clean_text.split("```json")[1].split("```")[0].strip()
        elif "```" in clean_text:
            clean_text = clean_text.split("```")[1].split("```")[0].strip()

        # 2. Extract strictly between first { and last }
        start_idx = clean_text.find("{")
        end_idx = clean_text.rfind("}")
        if start_idx != -1 and end_idx != -1:
            clean_text = clean_text[start_idx : end_idx + 1]

        try:
            # 3. Direct Parse Attempt
            return json.loads(clean_text)
        except json.JSONDecodeError:
            # 4. EMERGENCY REPAIR: Attempt to close dangling JSON (often happens with large summaries)
            try:
                # Remove trailing commas
                fixed = re.sub(r',\s*([\]}])', r'\1', clean_text)
                # Count braces
                open_b = fixed.count('{')
                close_b = fixed.count('}')
                open_sq = fixed.count('[')
                close_sq = fixed.count(']')
                
                # Append missing closers
                fixed += (']' * (open_sq - close_sq))
                fixed += ('}' * (open_b - close_b))
                
                return json.loads(fixed)
            except Exception:
                # 5. Final Fallback: Structured Recovery Object
                return {
                    "summary": "CRITICAL: The LLM response was too large and malformed. Raw response saved in Deep-Dive.",
                    "description": text,
                    "functions": [],
                    "data_dictionary": [],
                    "confidence_score": 0.4,
                    "auto_approval_status": False
                }

    # --- PHASE 2: FORENSIC KNOWLEDGE EXTRACTION ---

    def generate_documentation(self, code: str) -> dict:
        """
        Step 1: Deep-Dive Logic Extraction.
        Demands an exhaustive 300+ word technical narrative with NO HTML.
        """
        prompt = f"""
        Act as a Principal Systems Architect. Perform an EXHAUSTIVE forensic analysis of this code.
        You must explain every logical path, business rule, and data dependency.

        SOURCE CODE:
        \"\"\"
        {code}
        \"\"\"

        Return ONLY a JSON object with exactly these keys:
        1. "summary": A LONG (300+ words), multi-paragraph technical summary of the system's goals and architecture. NO HTML.
        2. "description": Detailed multi-paragraph breakdown of execution flow, logic, and side effects.
        3. "functions": List of {{'name', 'purpose', 'logic_explanation', 'business_rules'}}.
        4. "data_dictionary": List of {{'variable', 'role'}} mapping legacy fields to business meaning.
        5. "dependencies": List of external files, DBs, or libraries.
        6. "complexity_rating": Integer (1-10).
        7. "confidence_score": Float (0.0 to 1.0).
        8. "auto_approval_status": Boolean.

        MANDATORY: Output ONLY JSON.
        """

        payload = {
            "messages": [
                {"role": "system", "content": "You are a professional software analyst. You provide extremely long, technical, plain-text documentation in JSON format."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1 # Low temperature for better JSON compliance
        }

        try:
            # Increase timeout for voluminous code analysis
            response = self.session.post(self.endpoint, json=payload, timeout=180)
            response.raise_for_status()
            content = response.json()['choices'][0]['message']['content']
            return self._sanitize_json(content)
        except Exception as e:
            return {
                "summary": f"Connection Error: {str(e)}",
                "description": "The request to the LLM failed. Check your LLM_ENDPOINT and key."
            }

    # --- PHASE 3: HIGH-FIDELITY SYNTHESIS ENGINE ---

    def get_synthesis_prompt(self, doc_data: dict, target_stack: str) -> str:
        """
        Step 2: Unified File Synthesis.
        Enforces 100% logic parity and complete file structure.
        """
        java_constraints = ""
        if "Java" in target_stack:
            java_constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT: Do not use @Service, @Component, or annotations.\n"
                "- STANDARD JDK LIBRARIES: Use java.util, java.math.BigDecimal, java.time, etc.\n"
            )

        return f"""
        TASK: GENERATE THE COMPLETE, RUNNABLE SOURCE CODE FOR A SINGLE {target_stack} FILE.
        FAILURE IS NOT AN OPTION. DO NOT GENERATE SNIPPETS. 

        INPUT SPECIFICATION:
        {json.dumps(doc_data)}

        STRICT ARCHITECTURAL REQUIREMENTS:
        1. COMPLETE FILE STRUCTURE: Include package declarations, all necessary imports, and the public class definition.
        2. ENCAPSULATION & STATE: Map all legacy global variables (found in Data Dictionary) to PRIVATE CLASS MEMBER VARIABLES to maintain logical state.
        3. 100% LOGIC PARITY: Implement every mathematical formula and conditional branch from the spec with zero omissions.
        4. SINGLE FILE: The output must be a cohesive, standalone unit.
        5. CLEAN CODE: Refactor procedural logic into clean methods; use meaningful variable names.
        6. {java_constraints}

        Return ONLY the source code. No conversational text.
        """

    def stream_llm(self, prompt: str):
        """Standardized SSE Parser for real-time streaming to Streamlit."""
        payload = {
            "messages": [
                {"role": "system", "content": "You are a Senior Architect. You produce complete, accurate, runnable source files."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True 
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=300) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if not line:
                        continue
                    
                    line_text = line.decode("utf-8").strip()
                    if line_text.startswith("data: "):
                        content_raw = line_text[6:]
                        if content_raw == "[DONE]":
                            break
                        try:
                            chunk_json = json.loads(content_raw)
                            delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                            if delta:
                                yield delta
                        except:
                            continue
        except Exception as e:
            yield f"\n[STREAM_ERROR: {str(e)}]"

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Step 3: Full Test Suite Generation."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        TASK: Generate a single comprehensive {framework} test file for the code below.
        
        CODE:
        {modern_code}
        
        REQUIREMENTS:
        - Ensure 100% path coverage.
        - Mock dependencies where necessary.
        - Return ONLY the test source code.
        """

    def calculate_dashboard_metrics(self, doc_data: dict) -> dict:
        """Dashboard Heatmap logic."""
        conf = doc_data.get('confidence_score', 0.5)
        # Zones do not block processing, they only flag risk
        if conf >= 0.85:
            return {"zone": "GREEN (Ready)", "color": "green", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 5)}
        elif conf >= 0.60:
            return {"zone": "AMBER (Review Recommended)", "color": "orange", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 7)}
        else:
            return {"zone": "RED (High Risk)", "color": "red", "confidence_pct": f"{conf*100:.0f}%", "complexity": doc_data.get('complexity_rating', 9)}
