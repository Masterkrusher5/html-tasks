import os
import json
import re
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class UnifiedOpenAIAgent:
    """
    Forensic Modernization Engine.
    Optimized for high-density code synthesis and concise technical documentation.
    Communicates via direct HTTP requests to any LLM endpoint.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            return

        # Connection Pooling for high performance
        self.session = requests.Session()
        # Standard header setup for Azure/Enterprise Gateways
        self.session.headers.update({
            "api-key": self.api_key,
            "Content-Type": "application/json"
        })

    def _safe_truncate(self, text: str, max_chars: int = 15000) -> str:
        """
        Prevents 400 Bad Request errors by ensuring the input payload 
        doesn't exceed the context window limits.
        """
        return text[:max_chars] if len(text) <= max_chars else text[:max_chars] + "\n...[TRUNCATED]..."

    # --- PHASE 1: TECHNICAL DOCUMENTATION ---

    def get_documentation_prompt(self, code: str) -> str:
        """
        Analyst Thread: Generates a Markdown report.
        Strictly limits output to Summary, Flow, and Data to save tokens.
        """
        safe_code = self._safe_truncate(code)
        
        return f"""
        Act as a Principal Systems Architect. Analyze the legacy code and provide a Markdown report.
        
        STRICT OUTPUT FORMAT (NO OBSERVATIONS, NO RECOMMENDATIONS):
        
        ### 1. Technical Summary
        (Concise 100-150 word narrative explaining business domain and goal.)

        ### 2. Execution Flow
        (Bulleted list of internal logic flow and state transitions.)

        ### 3. Data Dictionary
        (Table of key variables and their business roles.)
        
        NO HTML. NO EXTRA CONVERSATIONAL TEXT.
        
        CODE:
        \"\"\"
        {safe_code}
        \"\"\"
        """

    # --- PHASE 2: HIGH-DENSITY SYNTHESIS ---

    def get_synthesis_prompt(self, code: str, target_stack: str) -> str:
        """
        Coder Thread: Zero-Shot Direct Translation.
        Removes verbose comments and explanations to ensure the file fits in the output window.
        """
        safe_code = self._safe_truncate(code)
        
        java_constraints = ""
        if "Java" in target_stack:
            java_constraints = (
                "- Target: Vanilla Java 17+.\n"
                "- NO SPRING BOOT/Annotations.\n"
                "- Standard JDK libraries only."
            )

        return f"""
        TASK: CONVERT LEGACY CODE TO A SINGLE COMPLETE {target_stack} FILE.
        
        CRITICAL TOKEN SAVING RULES:
        1. NO COMMENTS: Do not write comments explaining the code. Only write code.
        2. NO OBSERVATIONS/RECOMMENDATIONS: Do not add notes at the end.
        3. NO MARKDOWN WRAPPERS: Just start with the code.
        4. DENSE LOGIC: Keep whitespace standard but minimal.
        
        ARCHITECTURAL REQUIREMENTS:
        1. COMPLETE FILE: Package, Imports, Class, Methods.
        2. STATE: Map legacy globals to private class fields.
        3. 100% LOGIC PARITY: Replicate all math/logic exactly.
        4. {java_constraints}

        LEGACY SOURCE:
        \"\"\"
        {safe_code}
        \"\"\"

        START CODE IMMEDIATELY:
        """

    # --- STREAMING ENGINE ---

    def stream_llm(self, prompt: str, max_tokens: int = 4000):
        """
        Standardized SSE (Server-Sent Events) Parser.
        Configured for maximum output length to prevent truncation.
        """
        payload = {
            "messages": [
                {"role": "system", "content": "You are a code generator. Output ONLY code. Do not cut off."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": True,
            "max_tokens": max_tokens # Request maximum possible tokens
        }

        try:
            with self.session.post(self.endpoint, json=payload, stream=True, timeout=180) as resp:
                resp.raise_for_status()
                for line in resp.iter_lines():
                    if line:
                        line_text = line.decode("utf-8").strip()
                        if line_text.startswith("data: "):
                            content_raw = line_text[6:]
                            if content_raw == "[DONE]":
                                break
                            try:
                                chunk_json = json.loads(content_raw)
                                delta = chunk_json['choices'][0].get('delta', {}).get('content', '')
                                if delta:
                                    yield delta
                            except (json.JSONDecodeError, KeyError, IndexError):
                                continue
        except Exception as e:
            yield f"\n[STREAMING_ERROR: {str(e)}]"

    # --- PHASE 3: VALIDATION ---

    def get_test_prompt(self, modern_code: str, target_stack: str) -> str:
        """Generates unit tests based on the synthesized code."""
        framework = "JUnit 5" if "Java" in target_stack else "pytest"
        return f"""
        Generate a {framework} test suite for this code. 
        NO EXPLANATIONS. CODE ONLY.
        
        CODE:
        {modern_code}
        """

    def calculate_dashboard_metrics(self, doc_text: str) -> dict:
        """
        Calculates heuristics based on the length of the generated documentation.
        """
        length = len(doc_text)
        if length > 800:
            return {"zone": "GREEN", "color": "green", "confidence_pct": "95%", "complexity": "Medium"}
        elif length > 400:
            return {"zone": "AMBER", "color": "orange", "confidence_pct": "85%", "complexity": "High"}
        else:
            return {"zone": "RED", "color": "red", "confidence_pct": "50%", "complexity": "Critical"}
