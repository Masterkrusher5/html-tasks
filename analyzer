import os
import re

class FileIngestor:
    """
    Phase 1: Legacy Code Ingestion & Structural Normalization.
    Responsible for preparing voluminous legacy source files for 
    Forensic Analysis by stripping noise and extracting architectural metadata.
    """

    @staticmethod
    def normalize(code: str) -> str:
        """
        Cleans legacy source code to maximize token efficiency and clarity.
        1. Collapses redundant multiple spaces (essential for fixed-format COBOL/VB).
        2. Standardizes indentation by stripping leading/trailing whitespace.
        3. Removes empty lines to condense the logic flow.
        """
        if not code:
            return ""

        # 1. Collapse multiple spaces into a single space
        code = re.sub(r' +', ' ', code)

        # 2. Process line by line to strip noise and remove empty lines
        lines = code.splitlines()
        normalized_lines = []
        
        for line in lines:
            clean_line = line.strip()
            # Only keep lines with actual content to reduce token volume
            if clean_line:
                normalized_lines.append(clean_line)

        return "\n".join(normalized_lines)

    @staticmethod
    def read_uploaded_file(uploaded_file) -> str:
        """
        Safely reads content from a Streamlit file buffer.
        Implements fallback decoding for legacy encodings (Latin-1/CP1252)
        commonly found in Mainframe or older Windows environments.
        """
        try:
            # Try standard UTF-8 first
            return uploaded_file.read().decode("utf-8")
        except UnicodeDecodeError:
            # Fallback for legacy character sets (VB6/COBOL exports)
            uploaded_file.seek(0)
            return uploaded_file.read().decode("latin-1", errors="ignore")

    @staticmethod
    def analyze_file_role(code: str, file_name: str) -> str:
        """
        Heuristic detection to determine if the file is a Main Entry Program
        or a Shared Component/Library. This helps the Analyzer set the 
        correct forensic context.
        """
        code_upper = code.upper()
        ext = os.path.splitext(file_name)[1].lower()

        # COBOL Heuristics
        if ext in ['.cbl', '.cob']:
            if "PROCEDURE DIVISION" in code_upper and "STOP RUN" in code_upper:
                return "Entry Program (Main)"
            return "Shared Library (Copybook/Subroutine)"

        # VB6 Heuristics
        if ext in ['.bas', '.frm', '.cls', '.vb']:
            if "SUB MAIN()" in code_upper or "PRIVATE SUB FORM_LOAD" in code_upper:
                return "Entry Program (Startup/UI)"
            return "Shared Library (Module/Class)"

        # Java Heuristics
        if ext == '.java':
            if "PUBLIC STATIC VOID MAIN" in code_upper:
                return "Entry Program (Main)"
            return "Shared Library (Utility/Model)"

        return "Source Component"

    @staticmethod
    def extract_metadata(uploaded_file, code: str) -> dict:
        """
        Extracts comprehensive metadata for the Ingestion Dashboard.
        Maps extensions to primary legacy technologies.
        """
        file_name = uploaded_file.name
        extension = os.path.splitext(file_name)[1].lower()
        
        lang_map = {
            '.cbl': 'COBOL',
            '.cob': 'COBOL',
            '.vb': 'Visual Basic 6',
            '.bas': 'VB Module',
            '.frm': 'VB Form',
            '.java': 'Legacy Java',
            '.txt': 'Generic Source'
        }
        
        return {
            "file_name": file_name,
            "extension": extension,
            "detected_language": lang_map.get(extension, "Unknown Tech"),
            "size_kb": round(uploaded_file.size / 1024, 2),
            "line_count": len(code.splitlines()),
            "role": FileIngestor.analyze_file_role(code, file_name)
        }

    @staticmethod
    def build_call_graph_hints(code: str) -> list:
        """
        Forensic Scan: Identifies external dependencies, file associations, 
        and cross-program calls to help build the documentation's 'Dependencies' section.
        """
        patterns = [
            r'(?i)CALL\s+[\'\"](\w+)[\'\"]',    # COBOL CALLs
            r'(?i)COPY\s+(\w+)',                # COBOL COPYBOOKs
            r'(?i)SELECT\s+(\w+)\s+ASSIGN',     # COBOL File Selection
            r'(?i)Declare\s+Sub\s+(\w+)',       # VB API Declarations
            r'(?i)import\s+([\w\.]+)',          # Java Imports
            r'(?i)CreateObject\([\'\"]([\w\.]+)[\'\"]\)' # VB COM/ActiveX Objects
        ]
        
        found_hints = []
        for pattern in patterns:
            matches = re.findall(pattern, code)
            found_hints.extend(matches)
            
        return list(set(found_hints))
