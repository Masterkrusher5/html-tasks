import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class RAGContextEngine:
    """
    Step 3, 4 & 6: Unified Knowledge & Blueprint Engine.
    Transforms forensic analysis into a cohesive 'Technical Specification' 
    and 'Modernization Blueprint' for the Synthesis phase.
    """
    def __init__(self):
        # Configuration from Azure environment
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection Pooling for Azure OpenAI
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def _call_llm(self, prompt: str) -> str:
        """Internal helper to communicate with Azure OpenAI."""
        payload = {
            "messages": [
                {
                    "role": "system", 
                    "content": "You are a Technical Architect specializing in Business Logic Extraction."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ],
            "temperature": 0
        }
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=60)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"BLUEPRINT_GENERATION_ERROR: {str(e)}"

    def get_unified_context(self, forensic_data: dict, original_code: str) -> str:
        """
        Step 3 & 6: Context Retrieval & Blueprinting.
        Synthesizes the Forensic Analysis into a single architectural blueprint.
        Ensures the synthesis agent understands global state and execution flow.
        """
        prompt = f"""
        Act as a Lead Solutions Architect. Your task is to create a 'Modernization Blueprint' 
        based on the following Forensic Analysis of a legacy system.

        FORENSIC DATA:
        {json.dumps(forensic_data)}

        ORIGINAL CODE REFERENCE:
        \"\"\"
        {original_code[:2000]}  # Providing a snippet for context
        \"\"\"

        INSTRUCTIONS:
        1. Unified Logic Flow: Describe the end-to-end execution path from entry to exit.
        2. State Management: Identify all global variables or file-based states that must be maintained.
        3. Business Rule Consolidation: Summarize the critical formulas and decision trees.
        4. Modernization Strategy: Suggest how to structure the modern class (e.g., private helper methods, 
           data models, and error handling patterns).

        This blueprint will be used by a Coder Agent to write the final source code. 
        Be extremely precise and technical.
        """
        return self._call_llm(prompt)

    def formalize_forensic_report(self, doc_data: dict) -> str:
        """
        Step 4: Formal Documentation.
        Converts the raw forensic JSON into a human-readable, professional 
        Technical Specification for the UI.
        """
        summary = doc_data.get("summary", "N/A")
        description = doc_data.get("description", "N/A")
        
        report = f"### 📘 Technical Specification\n\n**Overview:** {summary}\n\n**Business Logic:** {description}\n\n"
        
        # Add Data Dictionary Section
        if "data_dictionary" in doc_data:
            report += "#### 📊 Data Dictionary\n"
            report += "| Variable | Type | Business Role |\n| :--- | :--- | :--- |\n"
            for item in doc_data["data_dictionary"]:
                report += f"| {item.get('variable')} | {item.get('type')} | {item.get('role')} |\n"
        
        return report

    def calculate_blueprint_confidence(self, forensic_data: dict) -> float:
        """
        Calculates a confidence metric for the Knowledge Base phase.
        Feeds into the Dashboard's 'Auto-Approval' logic.
        """
        # Heuristic: If we have a Data Dictionary and more than 3 functions detected, 
        # confidence in the knowledge extraction is high.
        has_dict = len(forensic_data.get("data_dictionary", [])) > 0
        func_count = len(forensic_data.get("functions", []))
        
        score = 0.5
        if has_dict: score += 0.3
        if func_count > 2: score += 0.2
        
        return min(score, 1.0)
