import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class RAGContextEngine:
    """
    Step 3, 4 & 6: Unified Knowledge Extraction & Blueprint Engine.
    Refactored to communicate via direct HTTP requests to a generic LLM Endpoint.
    Transforms forensic analysis into professional documentation and architectural blueprints.
    """
    def __init__(self):
        # Configuration from .env
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        if not self.endpoint or not self.api_key:
            raise ValueError("LLM_ENDPOINT or LLM_KEY not found in environment variables.")
        
        # Connection Pooling for high performance
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key  # Standard for Azure/Enterprise Gateways
        })

    def _call_llm(self, prompt: str, system_message: str = "You are a Technical Architect.") -> str:
        """Internal helper to execute synchronous POST requests to the LLM."""
        payload = {
            "messages": [
                {"role": "system", "content": system_message},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0
        }
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=60)
            response.raise_for_status()
            res_data = response.json()
            return res_data['choices'][0]['message']['content']
        except Exception as e:
            return f"ERROR_CALLING_LLM: {str(e)}"

    def formalize_documentation(self, forensic_data: dict) -> str:
        """
        Step 4: Formal Technical Documentation.
        Takes the raw Forensic JSON and formats it into a high-contrast, 
        readable Technical Specification for the dashboard.
        """
        summary = forensic_data.get("summary", "N/A")
        description = forensic_data.get("description", "N/A")
        functions = forensic_data.get("functions", [])
        data_dict = forensic_data.get("data_dictionary", [])
        
        # 1. Header & Executive Summary
        doc = f"### 📘 Technical & Functional Specification\n\n"
        doc += f"#### 1. Executive Summary\n{summary}\n\n"
        doc += f"#### 2. Comprehensive Business Logic\n{description}\n\n"
        
        # 2. Forensic Data Dictionary (Legacy to Modern Variable Mapping)
        if data_dict:
            doc += "#### 3. Forensic Data Dictionary\n"
            doc += "| Legacy Variable | Inferred Type | Business Role / Meaning |\n"
            doc += "| :--- | :--- | :--- |\n"
            for item in data_dict:
                var = item.get("variable", "N/A")
                vtype = item.get("type", "N/A")
                role = item.get("role", "N/A")
                doc += f"| `{var}` | {vtype} | {role} |\n"
            doc += "\n"

        # 3. Procedure Breakdown
        if functions:
            doc += "#### 4. Granular Functional Analysis\n"
            doc += "| Procedure Name | Functional Goal | Key Business Rules |\n"
            doc += "| :--- | :--- | :--- |\n"
            for func in functions:
                name = func.get("name", "N/A")
                purpose = func.get("purpose", "N/A")
                rules = func.get("business_rules", "N/A")
                doc += f"| **{name}** | {purpose} | {rules} |\n"
            
        return doc

    def get_modernization_blueprint(self, forensic_data: dict, target_lang: str) -> str:
        """
        Step 6: Context Retrieval Engine.
        Synthesizes the forensic analysis into a 'Code Blueprint' to ensure 
        logical continuity during the synthesis phase.
        """
        prompt = f"""
        Act as a Lead Software Architect. Based on the Forensic Analysis provided, 
        design a structural blueprint for a single {target_lang} file.
        
        FORENSIC DATA:
        {json.dumps(forensic_data)}
        
        INSTRUCTIONS:
        1. Class Design: Define the primary class name and its structure.
        2. Logic Mapping: Map legacy paragraphs/functions to modern method signatures.
        3. State Management: Identify how to handle shared legacy variables (e.g. class-level members).
        4. Modern Patterns: Suggest specific {target_lang} patterns (e.g. Try-Catch blocks, Data Models).
        
        Return a concise architectural blueprint.
        """
        
        return self._call_llm(prompt, system_message="You are a Senior Software Architect.")

    def validate_auto_approval(self, forensic_data: dict) -> dict:
        """
        Step 5: Automated Correctness Evaluation (Quality Gate).
        Analyzes metrics to decide if the modernization can proceed automatically.
        """
        conf = forensic_data.get("confidence_score", 0)
        complexity = forensic_data.get("complexity_rating", 10)
        
        # Auto-Approval Criteria: High confidence (>85%) and manageable complexity (<8)
        is_approved = conf >= 0.85 and complexity < 8
        
        # Risk Mapping
        risk_level = "LOW" if complexity < 4 else "MEDIUM" if complexity < 8 else "HIGH"
        
        return {
            "status": "APPROVED" if is_approved else "MANUAL_REVIEW_REQUIRED",
            "confidence_pct": f"{conf * 100:.0f}%",
            "risk_level": risk_level,
            "reason": "Technical specs are clear and logic is unambiguous." if is_approved else "High complexity or low confidence detected. Manual oversight recommended."
        }
