import os
import json
import requests
from dotenv import load_dotenv

# Load Environment Variables
load_dotenv()

class RAGContextEngine:
    """
    Steps 3, 4, and 6: Unified Knowledge Engine.
    Refactored to treat legacy programs as a single cohesive logic block
    rather than fragmented semantic chunks.
    """
    def __init__(self):
        self.endpoint = os.getenv("LLM_ENDPOINT")
        self.api_key = os.getenv("LLM_KEY")
        
        # Connection setup for synchronous context extraction
        self.session = requests.Session()
        self.session.headers.update({
            "Content-Type": "application/json",
            "api-key": self.api_key
        })

    def _call_llm(self, prompt: str):
        """Standardized internal call to the LLM for context generation."""
        payload = {
            "messages": [
                {
                    "role": "system", 
                    "content": "You are a Systems Analyst specializing in Legacy Knowledge Extraction."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ],
            "temperature": 0
        }
        try:
            response = self.session.post(self.endpoint, json=payload, timeout=45)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"CONTEXT_EXTRACTION_ERROR: {str(e)}"

    def get_unified_context(self, graphs: dict, original_code: str):
        """
        Step 3 & 6: Unified Business Logic Spec.
        Analyzes the entire program's structural graphs and source code 
        to create a comprehensive 'blueprint' for the Synthesis Agent.
        """
        prompt = f"""
        Act as a Lead Systems Analyst. Your goal is to extract a unified business logic 
        specification for the following legacy program.
        
        STRUCTURAL GRAPHS (AST/CFG/DFG):
        {json.dumps(graphs)}
        
        ORIGINAL SOURCE CODE:
        \"\"\"
        {original_code}
        \"\"\"

        INSTRUCTIONS:
        1. Identify the Global State: List all shared variables, file pointers, or database connections.
        2. Map the End-to-End Flow: Describe how data enters the system, is transformed, and is outputted.
        3. Extract Core Rules: Summarize the primary business math or decision logic in plain English.
        4. Identify Side Effects: Note any logs, screen displays, or external system calls.
        
        Provide a cohesive summary that a Java Architect can use to rewrite this entire program 
        into a single Java class.
        """
        
        return self._call_llm(prompt)

    def calculate_documentation_confidence(self, context_summary: str):
        """
        Automated correctness evaluation of the generated context.
        Determines the 'Green/Amber/Red' rating for the dashboard logic.
        """
        if "ERROR" in context_summary:
            return 0.1
            
        # Heuristic: A robust context summary should be descriptive
        length = len(context_summary)
        if length > 500:
            return 0.98  # High confidence: Detailed specs
        elif length > 200:
            return 0.75  # Medium confidence: Basic specs
        return 0.40      # Low confidence: Vague specs
